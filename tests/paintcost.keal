import "../src/app.keal"
import "../src/paint.keal"

/// What a frame costs, on a document big enough for the cost to show.
///
///     tools/build.sh tests/paintcost.keal && build/paintcost
///
/// Three numbers per case, because they are three different questions. The
/// **first** frame wraps the whole document; **then** is the steady state, a
/// repaint with nothing changed, which is what a blinking caret and a moving
/// pointer cost; **after a keystroke** is the text having changed, which
/// throws the kept wrapping away.
///
/// It exists because this framework and the language it is written in are
/// developed together, and a language change that costs a few per cent on a
/// compiler compiling itself can cost more on a rasteriser: a paint loop is
/// dense in small calls. When the language gains something, this says what it
/// took. Run it before and after and compare — a single reading says nothing,
/// and the machine is usually busy.
///
/// What it found the first time it was used, and how to read the three
/// columns — which is the part that turned out to matter.
///
/// keal 1.3.0 put a call trace at every runtime failure site. Isolated
/// properly by the language session — two builds of two of *its* revisions, so
/// nothing else differs — the cost is not one number:
///
///     folding  100 lines   first +24 %   at rest +35 %   keystroke +25 %
///     folding 1000 lines         +15 %           +21 %             +17 %
///     folding 5000 lines          +6 %           +19 %              +7 %
///     not     5000 lines          +4 %           +11 %              +4 %
///
/// **The more work a call does, the less the frame pays.** Wrapping a document
/// is heavy per call, so it dilutes the per-call cost; a steady repaint is
/// dense in small ones, so it pays. That is also why a small document pays
/// more than a big one, which reads as backwards until you see it is the same
/// rule.
///
/// Three columns rather than one average is what made that visible, and it is
/// why they are separate here.
///
/// A note on the reading this repository took first, because it is the lesson
/// and not the number: measured from the outside, across a compiler upgrade,
/// the steady state looked like +12 to +18 % on five thousand lines — close to
/// the isolated +19 % — while the not-folding row looked like +22 to +27 %
/// against an isolated +11 %. Between those two readings this repository's own
/// code had changed as well as the compiler, so one row was somebody else's
/// change and one row was partly its own, and from outside there was no
/// telling which. Two builds of one revision is the only measurement that
/// answers; from here, saying so was the honest half.
val ui = Ui(canvasOffscreen(900, 700, 2.0), systemFonts(), darkTheme())
val area = Rect(0.0, 0.0, 900.0, 700.0)
func r(x: Float): String { return ((x * 10.0).round().toFloat() / 10.0).toString() }
proc measure(lines: Int, wrap: Bool) {
    var src = ""
    var i = 0
    while (i < lines) { src = src + "    val someName = anotherName.methodCall(argument, 12345) + tail\n"; i++ }
    val e0 = editor(src, "", 40, { s -> }).font(textMono(13.0))
    val ed = e0.wrappingLines(wrap).sized(880.0, 660.0)
    var tree = stack([column([ed]), nothing(), nothing()])
    layout(ui, tree, area)
    val t0 = kvNow()
    ui.canvas.clear(ui.theme.bg)
    paint(ui, tree)
    val first = kvNow() - t0
    val t1 = kvNow()
    var k = 0
    while (k < 20) { ui.canvas.clear(ui.theme.bg); paint(ui, tree); k++ }
    val ms = (kvNow() - t1) / 20.0
    val e2 = editor(src + "x", "", 40, { s -> }).font(textMono(13.0))
    val edX = e2.wrappingLines(wrap).sized(880.0, 660.0).keyed("same")
    var tree2 = stack([column([edX]), nothing(), nothing()])
    layout(ui, tree2, area)
    val t2 = kvNow()
    ui.canvas.clear(ui.theme.bg)
    paint(ui, tree2)
    val typed = kvNow() - t2
    val tag = if (wrap) { "folding " } else { "not     " }
    println(tag + lines.toString() + " lines: first " + r(first) + " ms, then " + r(ms) + " ms, after a keystroke " + r(typed) + " ms")
}
measure(100, true)
measure(1000, true)
measure(5000, true)
measure(5000, false)
