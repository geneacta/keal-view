import "../src/app.keal"
import "../src/paint.keal"

/// What a frame costs, on a document big enough for the cost to show.
///
///     tools/build.sh tests/paintcost.keal && build/paintcost
///
/// Three numbers per case, because they are three different questions. The
/// **first** frame wraps the whole document; **then** is the steady state, a
/// repaint with nothing changed, which is what a blinking caret and a moving
/// pointer cost; **after a keystroke** is the text having changed, which
/// throws the kept wrapping away.
///
/// It exists because this framework and the language it is written in are
/// developed together, and a language change that costs a few per cent on a
/// compiler compiling itself can cost more on a rasteriser: a paint loop is
/// dense in small calls. When the language gains something, this says what it
/// took. Run it before and after and compare — a single reading says nothing,
/// and the machine is usually busy.
///
/// Measured here across keal 1.2.0 → 1.3.0, which added a call trace to every
/// runtime failure site: steady-state paint went from 9.3 ms to 10.4-11.0 on
/// five thousand lines, six runs, +12 to +18 %. The language session had
/// +2.6 % on a real workload and +136 % on `fib(30)`; a paint loop sits
/// between them and nearer the first.
val ui = Ui(canvasOffscreen(900, 700, 2.0), systemFonts(), darkTheme())
val area = Rect(0.0, 0.0, 900.0, 700.0)
func r(x: Float): String { return ((x * 10.0).round().toFloat() / 10.0).toString() }
proc measure(lines: Int, wrap: Bool) {
    var src = ""
    var i = 0
    while (i < lines) { src = src + "    val someName = anotherName.methodCall(argument, 12345) + tail\n"; i++ }
    val e0 = editor(src, "", 40, { s -> }).font(textMono(13.0))
    val ed = e0.wrappingLines(wrap).sized(880.0, 660.0)
    var tree = stack([column([ed]), nothing(), nothing()])
    layout(ui, tree, area)
    val t0 = kvNow()
    ui.canvas.clear(ui.theme.bg)
    paint(ui, tree)
    val first = kvNow() - t0
    val t1 = kvNow()
    var k = 0
    while (k < 20) { ui.canvas.clear(ui.theme.bg); paint(ui, tree); k++ }
    val ms = (kvNow() - t1) / 20.0
    val e2 = editor(src + "x", "", 40, { s -> }).font(textMono(13.0))
    val edX = e2.wrappingLines(wrap).sized(880.0, 660.0).keyed("same")
    var tree2 = stack([column([edX]), nothing(), nothing()])
    layout(ui, tree2, area)
    val t2 = kvNow()
    ui.canvas.clear(ui.theme.bg)
    paint(ui, tree2)
    val typed = kvNow() - t2
    val tag = if (wrap) { "folding " } else { "not     " }
    println(tag + lines.toString() + " lines: first " + r(first) + " ms, then " + r(ms) + " ms, after a keystroke " + r(typed) + " ms")
}
measure(100, true)
measure(1000, true)
measure(5000, true)
measure(5000, false)
