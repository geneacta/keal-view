build/
tests/out/
# `units` writes the pictures it reads back into `out/` beside wherever it
# was launched — `build/` under tools/test.sh, the root if someone runs it
# from there.
out/
*.bmp
*.png.tmp

# Python leaves this behind every time the site generator runs. Untracked
# noise is where a real change hides, so it is named rather than swept up by
# hand — the same line, for the same reason, as in the Keal repository.
site/__pycache__/

# `examples/studio.keal` remembers where its panels were, beside itself. The
# README says to run it as `build/studio` from the root, so the file lands
# here — untracked noise is where a real change hides, so it is named.
studio-layout.txt
