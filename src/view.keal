import "./canvas.keal"
import "./color.keal"
import "./geom.keal"
import "./text.keal"
import "./theme.keal"

/// The view tree: what an application says it wants on the screen.
///
/// A view is described, not built. An application writes a function from its
/// state to a tree of these, keal-view lays the tree out, draws it, and routes
/// what the user does back to the handlers hanging off it. Nothing in the tree
/// survives a frame; the tree is thrown away and made again whenever a `Cell`
/// changes, and the only things that persist are the cells the application
/// holds and the small per-widget state keyed by identity in `Ui`.
///
/// There is one class here rather than a class per kind, and that is Keal's
/// doing, honestly stated: a trait is not a type in Keal, so a `List<Widget>`
/// of different implementations cannot exist. A tagged class is what the
/// language offers, so a tagged class is what this is. The constructors below
/// are the real interface — nothing outside this file sets `kind` by hand.

public val kBox = 0
public val kLabel = 1
public val kButton = 2
public val kSpacer = 3
public val kDivider = 4
public val kCheck = 5
public val kSlider = 6
public val kField = 7
public val kScroll = 8
public val kPanel = 9
public val kCustom = 10
public val kIcon = 11
public val kToggle = 12
public val kTabs = 13
public val kProgress = 14
public val kBadge = 15
public val kHandle = 16
public val kRadio = 17
public val kSegmented = 18

/// Where children sit along the axis they are stacked on.
public val mainStart = 0
public val mainCenter = 1
public val mainEnd = 2
public val mainBetween = 3

/// How wide (or tall) a child is across that axis.
public val crossStart = 0
public val crossCenter = 1
public val crossEnd = 2
public val crossStretch = 3

/// A button that is the main action, one that is not, and one that destroys.
public val plain = 0
public val primary = 1
public val quiet = 2
public val danger = 3

public class View {
    public var kind: Int = 0
    public var vertical: Bool = false
    public var label: String = ""
    public var kids: List<View> = []

    /// Given by the application to keep a widget's own state — a scroll
    /// position, a caret — attached to it when the list around it changes.
    public var key: String = ""
    /// Filled in during layout: the identity this node's retained state hangs
    /// on. Derived from the path down the tree, and from `key` where there is
    /// one.
    public var id: Int = 0

    // ------------------------------------------------------------ box model
    public var pad: Insets = all(0.0)
    public var space: Float = 0.0
    /// A fixed size, or -1 to take whatever the content needs.
    public var wantW: Float = -1.0
    public var wantH: Float = -1.0
    public var minW: Float = 0.0
    public var minH: Float = 0.0
    /// Share of the space left over on the main axis. 0 takes none.
    public var weight: Float = 0.0
    /// This view asks for nothing of its own along the stacking axis, and
    /// takes only its share. What `grows()` sets.
    public var basisZero: Bool = false
    public var mainAlign: Int = 0
    public var crossAlign: Int = 3

    // ---------------------------------------------------------- appearance
    /// A background, or 0 for none. Widgets that draw themselves read the
    /// theme instead and leave this alone.
    public var fill: Int = 0
    public var stroke: Int = 0
    public var strokeW: Float = 0.0
    public var radius: Float = 0.0
    /// Text colour, or 0 to take the theme's.
    public var fg: Int = 0
    public var style: TextStyle = text(13.0)
    public var styled: Bool = false
    public var align: Int = 0
    /// A drop shadow this many points across, or 0 for none.
    public var elevate: Float = 0.0
    /// Wrap the label over several lines instead of cutting it with an
    /// ellipsis.
    public var wraps: Bool = false

    // ------------------------------------------------------------ behaviour
    public var enabled: Bool = true
    public var on: Bool = false
    public var value: Float = 0.0
    public var lo: Float = 0.0
    public var hi: Float = 1.0
    public var step: Float = 0.0
    public var hint: String = ""
    public var variant: Int = 0
    public var icon: String = ""
    /// Selected index, for tabs.
    public var index: Int = 0
    /// Answers the pointer with `onDrag` rather than with a click.
    public var draggable: Bool = false
    /// A view that is not a control but still takes a click — what makes a
    /// `custom` able to be a widget of its own.
    public var clickable: Bool = false
    /// The pointer shape over this view, or -1 to leave it alone.
    public var cursor: Int = -1
    /// A line of text to show beside the pointer while it rests here.
    public var tipText: String = ""
    /// Children's `weight` is an exact share of the room rather than a share
    /// of what is left over — which is what a splitter needs and what a
    /// stack of buttons does not.
    public var exact: Bool = false
    /// Children are laid on top of one another in the same rectangle, in the
    /// order given, rather than stacked end to end.
    public var layered: Bool = false
    /// Inside a `stack`, sit at a named position instead of filling it.
    public var placed: Bool = false
    public var placeX: Float = 0.0
    public var placeY: Float = 0.0
    public var options: List<String> = []
    public var password: Bool = false

    public var onTap: () -> Unit = { -> }
    public var onBool: (Bool) -> Unit = { b -> }
    public var onFloat: (Float) -> Unit = { v -> }
    public var onString: (String) -> Unit = { s -> }
    public var onIndex: (Int) -> Unit = { i -> }
    /// The moment the pointer goes down on this view, in window points —
    /// before it is known whether this will be a click or a drag. Where a
    /// handler records what it is dragging *from*.
    public var onGrab: (Float, Float) -> Unit = { x, y -> }
    /// Where the pointer is now, in window points, while dragging.
    public var onDrag: (Float, Float) -> Unit = { x, y -> }
    /// Where the pointer let go, in window points. Only called if the press
    /// actually turned into a drag — a plain click fires `onTap` instead.
    public var onDragEnd: (Float, Float) -> Unit = { x, y -> }
    /// A view that paints itself, handed a `Paint`: a canvas already clipped
    /// to its rectangle, that rectangle, the fonts and the theme.
    public var onDraw: (Paint) -> Unit = { p -> }

    /// Where layout put it, in points, in window coordinates.
    public var frame: Rect = noRect()
    /// What `measure` last decided it wants to be, so `arrange` need not ask
    /// again — measuring a label means walking its characters, and a frame
    /// would otherwise do that twice for every one of them.
    public var mw: Float = 0.0
    public var mh: Float = 0.0
    /// For a scrolling region: how tall its content turned out to be.
    public var content: Float = 0.0

    // ------------------------------------------------------------ modifiers
    //
    // Each answers the same view, so they chain. They mutate rather than copy
    // because a view is built once and thrown away, and copying a node per
    // modifier would allocate a tree per adjective.

    /// A fixed width.
    public func w(v: Float): View { this.wantW = v; return this }
    /// A fixed height.
    public func h(v: Float): View { this.wantH = v; return this }
    /// Both.
    public func sized(a: Float, b: Float): View { this.wantW = a; this.wantH = b; return this }
    /// A floor under the size, leaving the content free to ask for more.
    public func least(a: Float, b: Float): View { this.minW = a; this.minH = b; return this }
    /// Take a share of the room, starting from nothing rather than from what
    /// the content happens to want — CSS's `flex: 1`, and for the same reason:
    /// a pane that fills a window should be the size of the window, not the
    /// size of everything anyone ever put in it.
    public func grows(): View {
        this.weight = 1.0
        this.basisZero = true
        return this
    }
    /// A named share of it, on the same terms.
    public func growsBy(f: Float): View {
        this.weight = f
        this.basisZero = true
        return this
    }
    /// Take what the content needs, **and** a share of anything left over.
    ///
    /// The difference from `grows()` matters exactly once, and it is worth
    /// knowing which way round it is. `grows()` starts from nothing, so in a
    /// container that is sized by its own content there is nothing left over
    /// and a growing child gets zero height — right for a pane in a window,
    /// wrong for the body of a tab view inside a card. `fills()` starts from
    /// what the content asked for, so it is never smaller than its contents
    /// and still expands into a window when there is one.
    public func fills(): View {
        this.weight = 1.0
        this.basisZero = false
        return this
    }

    public func pads(i: Insets): View { this.pad = i; return this }
    /// The same padding on all four sides.
    public func padAll(v: Float): View { this.pad = all(v); return this }
    /// One padding across, another down.
    public func padXY(hx: Float, vy: Float): View { this.pad = axes(hx, vy); return this }
    /// Space between children.
    public func gaps(v: Float): View { this.space = v; return this }

    public func bg(c: Int): View { this.fill = c; return this }
    public func outline(c: Int, wd: Float): View { this.stroke = c; this.strokeW = wd; return this }
    public func rounded(r: Float): View { this.radius = r; return this }
    public func color(c: Int): View { this.fg = c; return this }
    public func font(st: TextStyle): View { this.style = st; this.styled = true; return this }
    /// The same face at another size.
    public func fontSize(v: Float): View {
        this.style = TextStyle(v, this.style.bold, this.style.mono)
        this.styled = true
        return this
    }
    public func bold(): View {
        this.style = TextStyle(this.style.size, true, this.style.mono)
        this.styled = true
        return this
    }
    public func mono(): View {
        this.style = TextStyle(this.style.size, this.style.bold, true)
        this.styled = true
        return this
    }
    public func centered(): View { this.align = 1; return this }
    public func trailing(): View { this.align = 2; return this }
    public func wrapping(): View { this.wraps = true; return this }
    /// Lift it off the surface with a shadow `blur` points across.
    public func raised(blur: Float): View { this.elevate = blur; return this }

    /// Give it a name of its own, so its retained state follows it when the
    /// list it sits in is reordered.
    public func keyed(k: String): View { this.key = k; return this }
    /// Grey it out and stop it responding.
    public func off(): View { this.enabled = false; return this }
    /// Grey it out when `c` holds.
    public func offWhen(c: Bool): View { this.enabled = not c; return this }
    /// How children sit along and across the stacking axis.
    public func aligned(mainA: Int, crossA: Int): View {
        this.mainAlign = mainA
        this.crossAlign = crossA
        return this
    }
    /// A style for a button: `plain`, `primary`, `quiet` or `danger`.
    public func kindOf(v: Int): View { this.variant = v; return this }
    /// An icon before the label — see `icon()` for the names.
    public func withIcon(name: String): View { this.icon = name; return this }
    /// Divide the room among the children in proportion to their `weight`,
    /// exactly, rather than sharing out only the surplus. Children with no
    /// weight keep the size they asked for and are taken off the top.
    public func shares(): View { this.exact = true; return this }
    /// Let the pointer drag this view. All three are given window points:
    /// `grab` when the button goes down, `move` as it travels, `drop` where it
    /// let go. A press that never moved is a click and fires `onTap` instead.
    public func dragged(grab: (Float, Float) -> Unit,
                        move: (Float, Float) -> Unit,
                        drop: (Float, Float) -> Unit): View {
        this.draggable = true
        this.onGrab = grab
        this.onDrag = move
        this.onDragEnd = drop
        return this
    }
    /// Take a click without being a control — what turns a `custom` into a
    /// widget of its own.
    public func tappable(f: () -> Unit): View {
        this.onTap = f
        this.clickable = true
        return this
    }
    /// The pointer shape while over this view.
    public func pointer(c: Int): View { this.cursor = c; return this }
    /// A note that appears beside the pointer while it rests on this view.
    public func tip(s: String): View { this.tipText = s; return this }
    /// Draw it, or do not — without the caller writing an `if` around a list.
    public func shownWhen(c: Bool): View {
        if (not c) { this.kind = kSpacer; this.kids = [] }
        return this
    }
    /// Space outside the view rather than inside it.
    public func margin(v: Float): View {
        this.pad = Insets(this.pad.left + v, this.pad.top + v,
                          this.pad.right + v, this.pad.bottom + v)
        return this
    }
    /// Inside a `stack`, put this view at these window points and give it the
    /// size it asked for, rather than the whole layer. Menus, tooltips and
    /// the ghost under a drag are all this.
    public func at(x: Float, y: Float): View {
        this.placed = true
        this.placeX = x
        this.placeY = y
        return this
    }
}

func mk(kind: Int): View {
    val v = View()
    v.kind = kind
    return v
}

// ------------------------------------------------------------- containers

/// Children stacked downwards.
public func column(kids: List<View>): View {
    val v = mk(kBox)
    v.vertical = true
    v.kids = kids
    return v
}

/// Children stacked across.
public func row(kids: List<View>): View {
    val v = mk(kBox)
    v.vertical = false
    v.kids = kids
    return v
}

/// Children one on top of another, all in the same rectangle, the last one
/// nearest the viewer. This is how a drag ghost, a menu or a dialog gets over
/// the interface without the interface knowing about it — and, because `hit`
/// searches children last first, the top layer answers the pointer first.
public func stack(kids: List<View>): View {
    val v = mk(kBox)
    v.layered = true
    v.vertical = true
    v.kids = kids
    return v
}

/// One child in a box of its own — somewhere to hang a background, a padding
/// or a shadow that the child should not carry itself.
public func box(kid: View): View { return column([kid]) }

/// A titled surface: a heading strip, a hairline, and the content below.
public func panel(title: String, kids: List<View>): View {
    val v = mk(kPanel)
    v.label = title
    v.vertical = true
    v.kids = kids
    return v
}

/// A region that scrolls vertically when its content is taller than it is.
public func scroll(kids: List<View>): View {
    val v = mk(kScroll)
    v.vertical = true
    v.kids = kids
    return v
}

/// A view that is nothing: no size, no ink, no answer to the pointer. What an
/// overlay is when there is nothing to overlay.
public func nothing(): View { return mk(kSpacer) }

/// Empty space that takes whatever is left over. Two of them centre what is
/// between them.
public func spacer(): View {
    val v = mk(kSpacer)
    v.weight = 1.0
    return v
}

/// Empty space of exactly this size.
public func gapV(hh: Float): View { return mk(kSpacer).h(hh) }
public func gapH(ww: Float): View { return mk(kSpacer).w(ww) }

/// A hairline across the container it sits in.
public func divider(): View { return mk(kDivider) }

// ---------------------------------------------------------------- content

/// A line of text.
public func label(s: String): View {
    val v = mk(kLabel)
    v.label = s
    return v
}

/// A line of text that carries less weight than the body.
public func caption(s: String): View {
    val v = label(s)
    v.variant = 1
    return v
}

/// A heading.
public func heading(s: String): View {
    val v = label(s)
    v.variant = 2
    return v
}

/// A title.
public func title(s: String): View {
    val v = label(s)
    v.variant = 3
    return v
}

/// A paragraph, wrapped to the width it is given.
public func paragraph(s: String): View { return label(s).wrapping() }

/// A small pill of text — a count, a status, a tag.
public func badge(s: String): View {
    val v = mk(kBadge)
    v.label = s
    return v
}

/// A surface with a border and room to breathe — the default container for a
/// group of things that belong together.
public func card(kids: List<View>, t: Theme = theme()): View {
    val v = column(kids)
    v.gaps(t.gap(2.0))
    v.padAll(t.gap(4.0))
    v.bg(t.surface)
    v.rounded(t.radiusLg)
    v.outline(t.border, t.hairline)
    return v
}

/// A card that lifts off the page.
public func raisedCard(kids: List<View>, t: Theme = theme()): View {
    return card(kids, t).raised(14.0)
}

/// A strip of tabs with the chosen one's content underneath.
public func tabView(titles: List<String>, index: Int, onChange: (Int) -> Unit,
                    content: View): View {
    return column([tabs(titles, index, onChange), content.fills()])
}

/// A line of text that acts on a click.
public func link(s: String, onTap: () -> Unit, t: Theme = theme()): View {
    val v = button(s, onTap)
    v.kindOf(quiet)
    v.color(t.accent)
    v.padXY(0.0, 0.0)
    v.pointer(1)          // a hand: a link is the one control that gets one
    return v
}

/// Something the application wants to say: `0` plain, `1` good, `2` a
/// warning, `3` a failure.
public func banner(level: Int, s: String, t: Theme = theme()): View {
    var tint = t.textSecondary
    var name = "dot"
    if (level == 1) { tint = t.success; name = "check" }
    if (level == 2) { tint = t.warning; name = "warning" }
    if (level == 3) { tint = t.danger; name = "close" }
    val v = row([
        icon(name).color(tint).fontSize(t.fontBase),
        label(s).color(t.textPrimary).grows()
    ])
    v.gaps(t.gap(2.0))
    v.padXY(t.gap(3.0), t.gap(2.5))
    v.bg(withAlpha(tint, 34))
    v.rounded(t.radiusMd)
    v.aligned(mainStart, crossCenter)
    return v
}

/// A number with a minus and a plus.
public func stepper(value: Float, lo: Float, hi: Float, step: Float,
                    onChange: (Float) -> Unit, t: Theme = theme()): View {
    val v = row([
        iconButton("minus", { -> onChange(clampF(value - step, lo, hi)) })
            .sized(t.control, t.control).offWhen(value <= lo),
        label(shortNumber(value)).centered().least(t.gap(9.0), 0.0),
        iconButton("plus", { -> onChange(clampF(value + step, lo, hi)) })
            .sized(t.control, t.control).offWhen(value >= hi)
    ])
    v.gaps(t.gap(0.5))
    v.aligned(mainStart, crossCenter)
    return v
}

/// A number without the trailing zeros nobody wanted.
public func shortNumber(v: Float): String {
    val whole = v.round()
    if ((v - whole.toFloat()).abs() < 0.0001) { return whole.toString() }
    return ((v * 100.0).round().toFloat() / 100.0).toString()
}

/// A shape drawn from a name rather than a font, so that an application has
/// icons without carrying a file: `check` `close` `plus` `minus` `chevron-down`
/// `chevron-right` `chevron-left` `chevron-up` `search` `menu` `dot` `gear`
/// `folder` `file` `play` `pause` `trash` `warning`.
public func icon(name: String): View {
    val v = mk(kIcon)
    v.icon = name
    return v
}

// --------------------------------------------------------------- controls

/// A button. Give it `.kindOf(primary)` to make it the main action.
public func button(s: String, on: () -> Unit): View {
    val v = mk(kButton)
    v.label = s
    v.onTap = on
    return v
}

/// A button that is only an icon — a toolbar, a close box.
public func iconButton(name: String, on: () -> Unit): View {
    val v = mk(kButton)
    v.icon = name
    v.variant = quiet
    v.onTap = on
    return v
}

/// A box that is ticked or not.
public func checkbox(s: String, on: Bool, changed: (Bool) -> Unit): View {
    val v = mk(kCheck)
    v.label = s
    v.on = on
    v.onBool = changed
    return v
}

/// One of several choices, shown as a dot.
public func radio(s: String, on: Bool, chose: () -> Unit): View {
    val v = mk(kRadio)
    v.label = s
    v.on = on
    v.onTap = chose
    return v
}

/// A row of choices, one of them pressed — a compact alternative to a set of
/// radios where there are two, three or four of them.
public func segmented(choices: List<String>, index: Int, onChange: (Int) -> Unit): View {
    val v = mk(kSegmented)
    v.options = choices
    v.index = index
    v.onIndex = onChange
    return v
}

/// The same choice as a switch.
public func toggle(s: String, on: Bool, changed: (Bool) -> Unit): View {
    val v = mk(kToggle)
    v.label = s
    v.on = on
    v.onBool = changed
    return v
}

/// A value chosen by dragging, between `lo` and `hi`. A non-zero `step`
/// snaps it.
public func slider(value: Float, lo: Float, hi: Float, changed: (Float) -> Unit): View {
    val v = mk(kSlider)
    v.value = value
    v.lo = lo
    v.hi = hi
    v.onFloat = changed
    return v
}

/// A bar that shows a fraction, 0.0 to 1.0, and takes no input.
public func progress(value: Float): View {
    val v = mk(kProgress)
    v.value = value
    return v
}

/// A line of text the user types. `hint` is shown when it is empty.
public func field(value: String, hint: String, changed: (String) -> Unit): View {
    val v = mk(kField)
    v.label = value
    v.hint = hint
    v.onString = changed
    return v
}

/// The same, showing dots.
public func secretField(value: String, hint: String, changed: (String) -> Unit): View {
    val v = field(value, hint, changed)
    v.password = true
    return v
}

/// A strip of tabs, one of them selected.
public func tabs(titles: List<String>, selected: Int, chose: (Int) -> Unit): View {
    val v = mk(kTabs)
    v.options = titles
    v.index = selected
    v.onIndex = chose
    return v
}

/// A bar to drag: the divider between two panes, the edge of a sidebar.
/// It draws as nothing until the pointer is on it, and then as a tint.
public func handle(vertical: Bool,
                   grab: (Float, Float) -> Unit,
                   move: (Float, Float) -> Unit): View {
    val v = mk(kHandle)
    v.vertical = vertical
    v.draggable = true
    v.onGrab = grab
    v.onDrag = move
    v.cursor = if (vertical) { 3 } else { 4 }
    return v
}

/// A view that paints and takes up no room — a background inside a `stack`,
/// a note of where something landed. It fills the layer it is in, because a
/// layer's children all get the layer's rectangle.
public func underlay(draw: (Paint) -> Unit): View {
    return custom(draw).sized(0.0, 0.0)
}

/// A view that paints itself: a chart, an editor, a game board. It is handed
/// a `Paint` — a clipped canvas, its rectangle, the fonts and the theme — so
/// it can draw text and match the rest of the interface without being told
/// twice what the interface looks like.
public func custom(draw: (Paint) -> Unit): View {
    val v = mk(kCustom)
    v.onDraw = draw
    return v
}
