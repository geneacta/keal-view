import "./canvas.keal"
import "./color.keal"
import "./geom.keal"
import "./layout.keal"
import "./text.keal"
import "./theme.keal"
import "./ui.keal"
import "./view.keal"

/// Drawing the tree.
///
/// Every widget's appearance is here and nowhere else, and every colour and
/// corner it uses comes off the `Theme`. That is what makes the look one
/// decision rather than forty: change the theme and every control changes with
/// it, including ones written after the theme was.

/// Draw a whole tree.
public proc paint(var ui: Ui, v: View) {
    if (isEmpty(v.frame)) { return }
    val c = ui.canvas
    if (not overlaps(v.frame, c.clip())) { return }
    paintNode(ui, v)
    if (v.kind == kScroll) {
        c.push(v.frame)
        paintKids(ui, v)
        c.pop()
        paintScrollbar(ui, v)
        return
    }
    if (v.kind == kCustom) { return }
    paintKids(ui, v)
}

proc paintKids(var ui: Ui, v: View) {
    var i = 0
    while (i < v.kids.size) {
        paint(ui, v.kids[i])
        i++
    }
}

proc paintNode(var ui: Ui, v: View) {
    val t = ui.theme
    val c = ui.canvas
    val r = v.frame

    // Anything may carry a background, a border and a shadow of its own,
    // whatever kind it is — that is what makes a plain `column` able to be a
    // card without a card widget existing.
    if (v.elevate > 0.0) { c.shadow(r, v.radius, v.elevate, v.elevate / 3.0, t.shadow) }
    if (alphaOf(v.fill) > 0) { c.fillRound(r, v.radius, v.fill) }
    if ((v.strokeW > 0.0) and (alphaOf(v.stroke) > 0)) {
        c.strokeRound(r, v.radius, v.strokeW, v.stroke)
    }

    if (v.kind == kLabel) { paintLabel(ui, v); return }
    if (v.kind == kButton) { paintButton(ui, v); return }
    if (v.kind == kCheck) { paintCheck(ui, v); return }
    if (v.kind == kToggle) { paintToggle(ui, v); return }
    if (v.kind == kRadio) { paintRadio(ui, v); return }
    if (v.kind == kSegmented) { paintSegmented(ui, v); return }
    if (v.kind == kSlider) { paintSlider(ui, v); return }
    if (v.kind == kProgress) { paintProgress(ui, v); return }
    if (v.kind == kField) { paintField(ui, v); return }
    if (v.kind == kEditor) { paintEditor(ui, v); return }
    if (v.kind == kBadge) { paintBadge(ui, v); return }
    if (v.kind == kIcon) {
        val ink = ui.inkFor(v)
        drawIcon(c, v.icon, r, ink, t.hairline * 1.6)
        return
    }
    if (v.kind == kDivider) {
        c.fillRect(Rect(r.x, r.y + (r.h - t.hairline) / 2.0, r.w, t.hairline), t.border)
        return
    }
    if (v.kind == kHandle) {
        // A divider is a gap until the pointer is on it, and then a line —
        // visible enough to aim at, quiet enough to forget.
        if (ui.isHot(v) or ui.isActive(v)) {
            val thin = if (v.vertical) {
                Rect(r.x + (r.w - t.hairline * 2.0) / 2.0, r.y, t.hairline * 2.0, r.h)
            } else {
                Rect(r.x, r.y + (r.h - t.hairline * 2.0) / 2.0, r.w, t.hairline * 2.0)
            }
            c.fillRound(thin, t.hairline, if (ui.isActive(v)) { t.accent } else { t.borderStrong })
        }
        return
    }
    if (v.kind == kTabs) { paintTabs(ui, v); return }
    if (v.kind == kPanel) { paintPanel(ui, v); return }
    if (v.kind == kCustom) {
        c.push(r)
        // `pointerOver`, not `isHot`: `isHot` compares against the click
        // target, and a `custom` that never asked to be clicked is never it.
        // Being under the pointer and being willing to take a click are
        // different questions, and this is the one the drawing asked.
        val over = ui.pointerOver(v)
        v.onDraw(Paint(c, r, ui.fonts, t, over, over and ui.pointer.down()))
        c.pop()
        return
    }
}

// ------------------------------------------------------------------ pieces

proc paintLabel(var ui: Ui, v: View) {
    val st = ui.styleFor(v)
    val ink = ui.inkFor(v)
    if (v.wraps) {
        ui.fonts.drawWrapped(ui.canvas, v.label, v.frame, st, ink)
        return
    }
    ui.fonts.drawIn(ui.canvas, v.label, v.frame, v.align, st, ink)
}

proc paintButton(var ui: Ui, v: View) {
    val t = ui.theme
    val c = ui.canvas
    val r = v.frame
    val hot = ui.isHot(v)
    val down = ui.isActive(v) and hot
    val rad = if (v.radius > 0.0) { v.radius } else { t.radiusMd }

    var face = t.surfaceHi
    var ink = t.textPrimary
    var edge = t.border
    if (v.variant == primary) {
        face = t.accent
        ink = t.textOnAccent
        edge = t.accent
        if (hot) { face = t.accentHover; edge = face }
        if (down) { face = t.accentDown; edge = face }
    } else { if (v.variant == quiet) {
        face = rgba(0, 0, 0, 0)
        ink = t.textSecondary
        edge = rgba(0, 0, 0, 0)
        if (hot) { face = t.surfaceHi; ink = t.textPrimary }
        if (down) { face = t.surfaceDown }
    } else { if (v.variant == danger) {
        face = t.danger
        ink = t.textOnAccent
        edge = t.danger
        if (hot) { face = lighten(t.danger, 0.12); edge = face }
        if (down) { face = darken(t.danger, 0.12); edge = face }
    } else {
        // A button may be given a face of its own; hover and press are then
        // derived from it rather than from the theme, so one keypad can have
        // three families of key without three variants existing.
        if (alphaOf(v.fill) > 0) { face = v.fill; edge = fade(v.fill, 0.0) }
        if (hot) { face = lighten(face, 0.07) }
        if (down) { face = darken(face, 0.10) }
    } } }
    // A colour named on the button itself wins over the variant's, so that
    // one destructive key in a grid can be red without being a whole variant.
    if (v.fg != 0) { ink = v.fg }
    // A disabled control looks inert whatever family it belongs to. Fading a
    // primary button leaves a washed-out blue with grey text on it, which
    // reads as broken rather than as unavailable.
    if (not v.enabled) {
        face = withAlpha(t.surfaceHi, 120)
        edge = withAlpha(t.border, 120)
        ink = t.textMuted
    }

    if (alphaOf(face) > 0) { c.fillRound(r, rad, face) }
    if (alphaOf(edge) > 0) { c.strokeRound(r, rad, t.hairline, edge) }
    focusRing(ui, v, rad)

    val st = ui.styleFor(v)
    val sc = c.scale
    val gap = t.gap(1.5)
    // An icon alone carries the whole button, so it is drawn to the button's
    // height rather than to the text size it does not have.
    var iconW = 0.0
    if (v.icon != "") {
        iconW = if (v.label == "") { (r.h * 0.56).min(26.0) } else { st.size + 3.0 }
    }
    val textW = if (v.label == "") { 0.0 } else { ui.fonts.width(v.label, st, sc) }
    var total = iconW + textW
    if ((iconW > 0.0) and (textW > 0.0)) { total = total + gap }
    // A button's label sits where it was told to: centred by default, which
    // is what a button wants, and to one side where the button is really a
    // row in a list.
    val padX = t.gap(3.0)
    var x = r.x + (r.w - total) / 2.0
    if (v.align == 0) { x = r.x + padX }
    if (v.align == 2) { x = r.x + r.w - total - padX }
    if (iconW > 0.0) {
        drawIcon(c, v.icon, Rect(x, r.y + (r.h - iconW) / 2.0, iconW, iconW), ink, t.hairline * 1.6)
        x = x + iconW
        if (textW > 0.0) { x = x + gap }
    }
    if (textW > 0.0) {
        ui.fonts.drawIn(c, v.label, Rect(x, r.y, textW, r.h), 0, st, ink)
    }
}

proc paintCheck(var ui: Ui, v: View) {
    val t = ui.theme
    val c = ui.canvas
    val r = v.frame
    val side = checkSize(t)
    val boxR = Rect(r.x, r.y + (r.h - side) / 2.0, side, side)
    val hot = ui.isHot(v)
    var face = t.surfaceHi
    var edge = if (hot) { t.borderStrong } else { t.border }
    if (v.on) { face = t.accent; edge = t.accent }
    if (not v.enabled) { face = fade(face, 0.45); edge = fade(edge, 0.45) }
    c.fillRound(boxR, t.radiusSm, face)
    c.strokeRound(boxR, t.radiusSm, t.hairline, edge)
    focusRing(ui, v, t.radiusSm)
    if (v.on) {
        drawIcon(c, "check", shrink(boxR, side * 0.22),
                 if (v.enabled) { t.textOnAccent } else { fade(t.textOnAccent, 0.6) },
                 t.hairline * 2.0)
    }
    if (v.label != "") {
        val x = r.x + side + t.gap(2.0)
        ui.fonts.drawIn(c, v.label, Rect(x, r.y, (r.w - side - t.gap(2.0)).max(0.0), r.h),
                        0, ui.styleFor(v), ui.inkFor(v))
    }
}

proc paintRadio(var ui: Ui, v: View) {
    val t = ui.theme
    val c = ui.canvas
    val r = v.frame
    val side = checkSize(t)
    val cx = r.x + side / 2.0
    val cy = centerY(r)
    val rad = side / 2.0
    val hot = ui.isHot(v)
    var edge = if (hot) { t.borderStrong } else { t.border }
    if (v.on) { edge = t.accent }
    if (not v.enabled) { edge = fade(edge, 0.45) }
    c.fillCircle(cx, cy, rad, if (v.enabled) { t.surfaceHi } else { fade(t.surfaceHi, 0.5) })
    c.strokeRound(Rect(cx - rad, cy - rad, side, side), rad, t.hairline, edge)
    if (v.on) {
        c.fillCircle(cx, cy, rad * 0.46,
                     if (v.enabled) { t.accent } else { fade(t.accent, 0.45) })
    }
    focusRing(ui, v, rad)
    if (v.label != "") {
        val x = r.x + side + t.gap(2.0)
        ui.fonts.drawIn(c, v.label, Rect(x, r.y, (r.w - side - t.gap(2.0)).max(0.0), r.h),
                        0, ui.styleFor(v), ui.inkFor(v))
    }
}

/// A row of choices in a well, the pressed one raised out of it.
proc paintSegmented(var ui: Ui, v: View) {
    val t = ui.theme
    val c = ui.canvas
    val r = v.frame
    val st = ui.styleFor(v)
    val sc = c.scale
    val n = v.options.size
    if (n == 0) { return }
    c.fillRound(r, t.radiusMd, t.surfaceDown)
    val pad = t.gap(0.75)
    val inner = shrink(r, pad)
    val w = inner.w / n.toFloat()
    var i = 0
    while (i < n) {
        val seg = Rect(inner.x + w * i.toFloat(), inner.y, w, inner.h)
        val chosen = i == v.index
        val hot = ui.isHot(v) and holds(seg, ui.pointer.x, ui.pointer.y)
        if (chosen) {
            c.shadow(seg, t.radiusSm, 4.0, 1.0, fade(t.shadow, 0.5))
            c.fillRound(seg, t.radiusSm, t.surface)
        } else {
            if (hot) { c.fillRound(seg, t.radiusSm, withAlpha(t.surfaceHi, 150)) }
        }
        val ink = if (chosen) { t.textPrimary }
                  else { if (v.enabled) { t.textSecondary } else { t.textMuted } }
        ui.fonts.drawIn(c, v.options[i], seg, 1, st, ink)
        i++
    }
}

proc paintToggle(var ui: Ui, v: View) {
    val t = ui.theme
    val c = ui.canvas
    val r = v.frame
    val sw = switchWidth(t)
    val sh = switchHeight(t)
    val trackR = Rect(r.x, r.y + (r.h - sh) / 2.0, sw, sh)
    var track = if (v.on) { t.accent } else { t.surfaceDown }
    if (not v.enabled) { track = fade(track, 0.45) }
    c.fillRound(trackR, sh / 2.0, track)
    if (not v.on) { c.strokeRound(trackR, sh / 2.0, t.hairline, t.border) }
    focusRing(ui, v, sh / 2.0)
    val kr = sh / 2.0 - t.gap(0.5)
    val kx = if (v.on) { trackR.x + sw - kr - t.gap(0.5) } else { trackR.x + kr + t.gap(0.5) }
    val ky = trackR.y + sh / 2.0
    c.shadow(Rect(kx - kr, ky - kr, kr * 2.0, kr * 2.0), kr, 3.0, 1.0, fade(t.shadow, 0.5))
    c.fillCircle(kx, ky, kr, rgb(255, 255, 255))
    if (v.label != "") {
        val x = r.x + sw + t.gap(2.0)
        ui.fonts.drawIn(c, v.label, Rect(x, r.y, (r.w - sw - t.gap(2.0)).max(0.0), r.h),
                        0, ui.styleFor(v), ui.inkFor(v))
    }
}

proc paintSlider(var ui: Ui, v: View) {
    val t = ui.theme
    val c = ui.canvas
    val r = v.frame
    val th = sliderTrack(t)
    val kn = sliderKnob(t)
    val y = r.y + r.h / 2.0
    val x0 = r.x + kn
    val x1 = r.x + r.w - kn
    val span = (x1 - x0).max(1.0)
    val frac = clampF((v.value - v.lo) / (v.hi - v.lo).max(0.000001), 0.0, 1.0)
    val kx = x0 + span * frac
    c.fillRound(Rect(x0, y - th / 2.0, span, th), th / 2.0,
                if (v.enabled) { t.surfaceDown } else { fade(t.surfaceDown, 0.5) })
    c.fillRound(Rect(x0, y - th / 2.0, span * frac, th), th / 2.0,
                if (v.enabled) { t.accent } else { fade(t.accent, 0.45) })
    if (ui.isHot(v) or ui.isActive(v)) {
        c.fillCircle(kx, y, kn + t.gap(1.5), t.accentSoft)
    }
    c.shadow(Rect(kx - kn, y - kn, kn * 2.0, kn * 2.0), kn, 4.0, 1.0, fade(t.shadow, 0.6))
    c.fillCircle(kx, y, kn, rgb(255, 255, 255))
    c.strokeRound(Rect(kx - kn, y - kn, kn * 2.0, kn * 2.0), kn, t.hairline, fade(t.border, 0.8))
}

proc paintProgress(var ui: Ui, v: View) {
    val t = ui.theme
    val c = ui.canvas
    val r = v.frame
    val h = r.h.min(t.gap(1.5))
    val bar = Rect(r.x, r.y + (r.h - h) / 2.0, r.w, h)
    c.fillRound(bar, h / 2.0, t.surfaceDown)
    val f = clampF(v.value, 0.0, 1.0)
    if (f > 0.0) { c.fillRound(Rect(bar.x, bar.y, bar.w * f, h), h / 2.0, t.accent) }
}

proc paintBadge(var ui: Ui, v: View) {
    val t = ui.theme
    val c = ui.canvas
    val r = v.frame
    var face = t.surfaceHi
    var ink = t.textSecondary
    if (v.variant == 1) { face = withAlpha(t.success, 40); ink = t.success }
    if (v.variant == 2) { face = withAlpha(t.warning, 40); ink = t.warning }
    if (v.variant == 3) { face = withAlpha(t.danger, 40); ink = t.danger }
    c.fillRound(r, r.h / 2.0, face)
    ui.fonts.drawIn(c, v.label, r, 1, ui.styleFor(v), ink)
}

proc paintField(var ui: Ui, v: View) {
    val t = ui.theme
    val c = ui.canvas
    val r = v.frame
    val focused = ui.isFocused(v)
    val rad = t.radiusMd
    c.fillRound(r, rad, if (v.enabled) { t.surfaceHi } else { fade(t.surfaceHi, 0.5) })
    val edge = if (focused) { t.accent } else { if (ui.isHot(v)) { t.borderStrong } else { t.border } }
    if (focused) { c.strokeRound(grow(r, 2.0), rad + 2.0, 2.0, t.accentSoft) }
    c.strokeRound(r, rad, t.hairline, edge)

    val st = ui.styleFor(v)
    val sc = c.scale
    val padX = t.gap(2.5)
    val inner = Rect(r.x + padX, r.y, (r.w - padX * 2.0).max(0.0), r.h)
    val shown = if (v.password) { "•".repeat(v.label.length) } else { v.label }
    c.push(inner)
    if (shown == "") {
        ui.fonts.drawIn(c, v.hint, inner, 0, st, t.textMuted)
    } else {
        val caret = clampI(ui.caretOf(v.id, shown.length), 0, shown.length)
        val anchor = clampI(ui.anchorOf(v.id, caret), 0, shown.length)
        val asc = ui.fonts.ascent(st, sc)
        val lh = ui.fonts.lineHeight(st, sc)
        val baseline = inner.y + (inner.h - lh) / 2.0 + asc
        // Keep the caret in sight by sliding the text under a fixed window.
        val cx = ui.fonts.xOfIndex(shown, caret, st, sc)
        var shift = ui.memoOf(mixId(v.id, 5), 0.0)
        if (cx - shift > inner.w - 2.0) { shift = cx - inner.w + 2.0 }
        if (cx - shift < 0.0) { shift = cx }
        val fullW = ui.fonts.width(shown, st, sc)
        if (fullW - shift < inner.w) { shift = (fullW - inner.w).max(0.0) }
        ui.setMemo(mixId(v.id, 5), shift)
        if (focused and (anchor != caret)) {
            val a = ui.fonts.xOfIndex(shown, caret.min(anchor), st, sc)
            val b = ui.fonts.xOfIndex(shown, caret.max(anchor), st, sc)
            c.fillRect(Rect(inner.x + a - shift, inner.y + (inner.h - lh) / 2.0, b - a, lh),
                       t.selection)
        }
        // A field takes coloured runs as an editor does — the two share every
        // other thing that works on offsets, and a rule that held in one and
        // not the other would be a rule nobody could remember. Never on a
        // secret field: the dots stand one for one with the characters, so
        // colouring them would draw the shape of the password.
        val runs = if (v.password) { emptyRuns() } else { v.inkRuns }
        drawRuns(ui, c, runs, shown, 0, inner.x - shift, baseline, st, ui.inkFor(v))
        if (focused) {
            // A caret that blinks means a frame drawn with nothing having
            // happened — so the loop is told to expect one, and told **when**.
            // Asking for "soon" gets sixteen full repaints a second to move one
            // bar; asking for the moment the bar next changes gets two.
            val period = 530.0
            ui.wakeIn(period - (ui.time % period))
            val phase = (ui.time / period).toInt() % 2
            if (phase == 0) {
                c.fillRect(Rect(inner.x + cx - shift, inner.y + (inner.h - lh) / 2.0 + 1.0,
                                t.hairline * 1.4, lh - 2.0), t.accent)
            }
        }
    }
    c.pop()
}

// --------------------------------------------------------------- the editor
//
// The geometry is written once and used twice: the painter draws where these
// say, and the dispatcher turns a click into an offset by asking the same
// questions. A widget whose picture and whose hit test each work out where the
// text is will disagree the first time one of them changes.

/// Where an editor's text lives inside its box.
public func editorInner(t: Theme, r: Rect): Rect {
    val padX = t.gap(2.5)
    val padY = t.gap(1.0)
    return Rect(r.x + padX, r.y + padY, (r.w - padX * 2.0).max(1.0),
                (r.h - padY * 2.0).max(1.0))
}

/// An editor's text, broken into lines at the width it actually has.
public func editorLines(ui: Ui, v: View): List<Line> {
    val inner = editorInner(ui.theme, v.frame)
    // An editor that does not fold long lines is the same wrapping asked for
    // at a column nothing reaches, which leaves the breaks the author typed
    // and adds none. One code path, not two: a second one would be a second
    // place for the offsets to be got wrong.
    val col = if (v.wrapsLines) { inner.w } else { 1000000000.0 }
    return ui.fonts.wrapLines(v.label, col, ui.styleFor(v), ui.canvas.scale)
}

/// How far an editor is scrolled sideways, in points.
///
/// Zero for one that folds its lines, which is why it is a function rather
/// than a memo read in five places: a folding editor has nothing to the side
/// of it, and the arithmetic that follows the caret along a line must not run
/// at all there.
public func editorShift(ui: Ui, v: View): Float {
    if (v.wrapsLines) { return 0.0 }
    return ui.memoOf(mixId(v.id, 12), 0.0).max(0.0)
}

/// How far down an editor is scrolled, with the caret followed if it has moved
/// since the last time this was asked.
///
/// The caret is followed **only when it has moved**, and that is the whole of
/// it. Following it every frame would undo the wheel: scroll away from the
/// caret and the next repaint — a blink of the caret is enough — would drag
/// the text back.
public func editorScroll(var ui: Ui, v: View, lines: List<Line>): Float {
    val st = ui.styleFor(v)
    val sc = ui.canvas.scale
    val inner = editorInner(ui.theme, v.frame)
    val lh = ui.fonts.lineHeight(st, sc)
    val room = ((lines.size.toFloat() * lh) - inner.h).max(0.0)
    var off = clampF(ui.scrollOf(v.id), 0.0, room)
    val n = v.label.length
    val caret = caretIn(ui, v)
    if (ui.memoOf(mixId(v.id, 9), -1.0).toInt() != caret) {
        val row = caretRow(ui, v, lines, caret)
        val top = row.toFloat() * lh
        if (top < off) { off = top }
        if ((top + lh) > (off + inner.h)) { off = top + lh - inner.h }
        off = clampF(off, 0.0, room)
        ui.setMemo(mixId(v.id, 9), caret.toFloat())
        // And sideways, for an editor that does not fold: the caret can be
        // anywhere along a line as long as the line is, and following it down
        // to a row it is not visible on is following it nowhere.
        if (not v.wrapsLines) {
            val l = lines[row]
            val body = v.label.substring(l.start, l.end)
            val cx = ui.fonts.xOfIndex(body, caret - l.start, st, sc)
            var sx = ui.memoOf(mixId(v.id, 12), 0.0)
            if ((cx - sx) > (inner.w - 2.0)) { sx = cx - inner.w + 2.0 }
            if (cx < sx) { sx = cx }
            ui.setMemo(mixId(v.id, 12), sx.max(0.0))
        }
    }
    ui.setScroll(v.id, off)
    // What the wheel needs, and it can only be known once the text has been
    // wrapped at the width the box turned out to have.
    ui.setMemo(mixId(v.id, 8), lines.size.toFloat() * lh)
    return off
}

/// What a point in an editor hits: the offset, and the row it was on.
///
/// **Both**, because the row cannot always be worked out again from the
/// offset. A word longer than the column is cut where no character sits, so
/// that one offset is the end of a line and the start of the next, and a
/// click at the left edge of the second row would come back as the right edge
/// of the first. Answered as a pair, in the way the rest of this framework
/// answers a pair — `x` is the offset and `y` is the row.
public func editorHitAt(ui: Ui, v: View, x: Float, y: Float): Rect {
    val st = ui.styleFor(v)
    val sc = ui.canvas.scale
    val inner = editorInner(ui.theme, v.frame)
    val lines = editorLines(ui, v)
    val lh = ui.fonts.lineHeight(st, sc)
    val off = ui.scrollOf(v.id)
    val row = clampI((((y - inner.y) + off) / lh).floor(), 0, lines.size - 1)
    val l = lines[row]
    val body = v.label.substring(l.start, l.end)
    val at = l.start + ui.fonts.indexAt(body, (x - inner.x) + editorShift(ui, v), st, sc)
    return Rect(at.toFloat(), row.toFloat(), 0.0, 0.0)
}

/// Which row the caret is drawn on.
///
/// Almost always `lineOfOffset`, and the exception is the one boundary
/// `wrapLines` cannot make unambiguous. A break at a space or a newline eats
/// its character, so the offset before it and the offset after it are
/// different numbers and belong to different lines. A word longer than the
/// column has no character to eat, so there the end of one row and the start
/// of the next **are the same offset**, and both answers are true.
///
/// `lineOfOffset` answers the earlier row, which is what an offset arriving
/// from somewhere with no opinion should get — it is what keeps End on a row
/// from painting the caret at the start of the row below. But two operations
/// do have an opinion, and it is the other one: a click knows which row it
/// landed on, and Down knows which row it went to. Without this, a click at
/// the left edge of the second row of a long word jumps the caret up to the
/// right edge of the first, and a Down aiming at column zero lands on an
/// offset that resolves back to the row it started on and does not move.
///
/// So those two leave the row they meant, and it is believed only while it
/// still contains the caret. A remembered row cannot go stale into a wrong
/// answer: change the text or the width and it stops containing the offset,
/// and this falls back to the rule.
public func caretRow(ui: Ui, v: View, lines: List<Line>, off: Int): Int {
    val want = ui.memoOf(mixId(v.id, 11), 0.0 - 1.0).toInt()
    if ((want >= 0) and (want < lines.size)) {
        if ((off >= lines[want].start) and (off <= lines[want].end)) { return want }
    }
    return lineOfOffset(lines, off)
}

/// No runs at all, named so that a caller can say it means none rather than
/// building an empty list at a place that is drawn every frame.
public func emptyRuns(): List<InkRun> { return [] }

/// One line of text, with whatever stretches of it have colours of their own.
///
/// `runs` are offsets into the whole label and this draws one line of it, so
/// each is clipped to `[from, from + body.length)` first. Anything no run
/// covers is drawn in `ink`. With no runs at all this is one `draw` call and
/// costs nothing, which is what every view but a code editor wants.
///
/// Each piece is placed with `xOfIndex` from the start of the line rather
/// than by adding up the pieces before it: widths are not additive under
/// kerning, and a caret placed by `xOfIndex` beside text placed by summation
/// would drift apart along the line — the caret sitting visibly to one side
/// of the letter it is between.
proc drawRuns(var ui: Ui, var c: Canvas, runs: List<InkRun>, body: String,
              from: Int, x: Float, base: Float, st: TextStyle, ink: Int) {
    if (runs.size == 0) { ui.fonts.draw(c, body, x, base, st, ink); return }
    val n = body.length
    val to = from + n
    var pos = 0
    for (r in runs) {
        if (r.end <= from) { continue }
        if (r.start >= to) { break }
        val a = (r.start - from).max(0).min(n)
        val b = (r.end - from).max(0).min(n)
        if (a > pos) {
            ui.fonts.draw(c, body.substring(pos, a),
                          x + ui.fonts.xOfIndex(body, pos, st, c.scale), base, st, ink)
        }
        if (b > a) {
            ui.fonts.draw(c, body.substring(a, b),
                          x + ui.fonts.xOfIndex(body, a, st, c.scale), base, st, r.ink)
        }
        pos = b.max(pos)
    }
    if (pos < n) {
        ui.fonts.draw(c, body.drop(pos),
                      x + ui.fonts.xOfIndex(body, pos, st, c.scale), base, st, ink)
    }
}

proc paintEditor(var ui: Ui, v: View) {
    val t = ui.theme
    val c = ui.canvas
    val r = v.frame
    val focused = ui.isFocused(v)
    val rad = t.radiusMd
    c.fillRound(r, rad, if (v.enabled) { t.surfaceHi } else { fade(t.surfaceHi, 0.5) })
    val edge = if (focused) { t.accent } else { if (ui.isHot(v)) { t.borderStrong } else { t.border } }
    if (focused) { c.strokeRound(grow(r, 2.0), rad + 2.0, 2.0, t.accentSoft) }
    c.strokeRound(r, rad, t.hairline, edge)

    val st = ui.styleFor(v)
    val sc = c.scale
    val inner = editorInner(t, r)
    c.push(inner)
    if (v.label == "") {
        // The hint sits on the first line rather than in the middle: an editor
        // is a column of text and its first line is where typing starts.
        val lh0 = ui.fonts.lineHeight(st, sc)
        ui.fonts.drawIn(c, v.hint, Rect(inner.x, inner.y, inner.w, lh0), 0, st, t.textMuted)
    }
    val lines = editorLines(ui, v)
    val lh = ui.fonts.lineHeight(st, sc)
    val asc = ui.fonts.ascent(st, sc)
    val off = editorScroll(ui, v, lines)
    // Read after `editorScroll`, which is what moves it: one place decides
    // where the text sits and everything below draws where it says.
    val shift = editorShift(ui, v)
    val left = inner.x - shift

    val n = v.label.length
    val caret = caretIn(ui, v)
    val anchor = clampI(ui.anchorOf(v.id, caret), 0, n)
    val selA = caret.min(anchor)
    val selB = caret.max(anchor)
    val ink = ui.inkFor(v)
    val space = ui.fonts.width(" ", st, sc)

    var i = (off / lh).floor().max(0)
    val last = (((off + inner.h) / lh).floor() + 1).min(lines.size - 1)
    while (i <= last) {
        val l = lines[i]
        val body = v.label.substring(l.start, l.end)
        val y = inner.y + (i.toFloat() * lh) - off
        if (focused and (selA != selB)) {
            val a = selA.max(l.start).min(l.end)
            val b = selB.max(l.start).min(l.end)
            // A selection that runs past this line covers the break as well,
            // and the break is a character the reader chose. It is shown as a
            // space's worth of colour past the last letter — without it, a
            // selection over three lines looks like three selections.
            val over = if ((selB > l.end) and (selA <= l.end)) { space } else { 0.0 }
            if ((b > a) or (over > 0.0)) {
                val x0 = ui.fonts.xOfIndex(body, a - l.start, st, sc)
                val x1 = ui.fonts.xOfIndex(body, b - l.start, st, sc)
                c.fillRect(Rect(left + x0, y, (x1 - x0) + over, lh), t.selection)
            }
        }
        drawRuns(ui, c, v.inkRuns, body, l.start, left, y + asc, st, ink)
        i++
    }

    if (focused) {
        val row = caretRow(ui, v, lines, caret)
        val l = lines[row]
        val cx = ui.fonts.xOfIndex(v.label.substring(l.start, l.end), caret - l.start, st, sc)
        val cy = inner.y + (row.toFloat() * lh) - off
        val period = 530.0
        ui.wakeIn(period - (ui.time % period))
        if (((ui.time / period).toInt() % 2) == 0) {
            c.fillRect(Rect(left + cx, cy + 1.0, t.hairline * 1.4, lh - 2.0), t.accent)
        }
    }
    c.pop()
}

proc paintTabs(var ui: Ui, v: View) {
    val t = ui.theme
    val c = ui.canvas
    val r = v.frame
    val st = ui.styleFor(v)
    val sc = c.scale
    c.fillRect(Rect(r.x, r.y + r.h - t.hairline, r.w, t.hairline), t.border)
    var x = r.x
    var i = 0
    while (i < v.options.size) {
        val label = v.options[i]
        val w = ui.fonts.width(label, st, sc) + t.gap(5.0)
        val tab = Rect(x, r.y, w, r.h)
        val selected = i == v.index
        val hot = ui.isHot(v) and holds(tab, ui.pointer.x, ui.pointer.y)
        if (hot and (not selected)) { c.fillRect(tab, withAlpha(t.surfaceHi, 140)) }
        val ink = if (selected) { t.textPrimary } else { t.textSecondary }
        ui.fonts.drawIn(c, label, tab, 1, st, ink)
        if (selected) {
            c.fillRound(Rect(tab.x + t.gap(1.5), r.y + r.h - t.gap(0.5),
                             w - t.gap(3.0), t.gap(0.5)), t.gap(0.25), t.accent)
        }
        x = x + w
        i++
    }
}

proc paintPanel(var ui: Ui, v: View) {
    val t = ui.theme
    val c = ui.canvas
    val r = v.frame
    val rad = if (v.radius > 0.0) { v.radius } else { t.radiusLg }
    if (alphaOf(v.fill) == 0) { c.fillRound(r, rad, t.surface) }
    if (v.strokeW <= 0.0) { c.strokeRound(r, rad, t.hairline, t.border) }
    if (v.label != "") {
        val strip = Rect(r.x, r.y, r.w, t.strip)
        ui.fonts.drawIn(c, v.label, inset(strip, axes(t.gap(3.5), 0.0)), 0,
                        textBold(t.fontBase), t.textSecondary)
        c.fillRect(Rect(r.x + t.hairline, r.y + t.strip, r.w - t.hairline * 2.0, t.hairline),
                   t.border)
    }
}

proc paintScrollbar(var ui: Ui, v: View) {
    val t = ui.theme
    val c = ui.canvas
    val r = v.frame
    val total = v.content
    if (total <= r.h + 0.5) { return }
    val off = ui.scrollOf(v.id)
    val w = t.gap(1.5)
    val trackH = r.h - t.gap(2.0)
    val thumbH = (trackH * r.h / total).max(t.gap(6.0))
    val travel = trackH - thumbH
    val frac = clampF(off / (total - r.h).max(1.0), 0.0, 1.0)
    val x = r.x + r.w - w - t.gap(1.0)
    val y = r.y + t.gap(1.0) + travel * frac
    val hot = ui.isHot(v) or ui.isActive(v)
    // The track is drawn too, faintly: a bar with nothing behind it reads as
    // a stray mark, and a scrollable region should say so before it is touched.
    c.fillRound(Rect(x, r.y + t.gap(1.0), w, trackH), w / 2.0, withAlpha(t.border, 120))
    c.fillRound(Rect(x, y, w, thumbH), w / 2.0,
                if (hot) { t.borderStrong } else { withAlpha(t.borderStrong, 190) })
}

/// The halo that says the keyboard is here. Drawn outside the control, so it
/// never eats into what the control was given.
proc focusRing(var ui: Ui, v: View, rad: Float) {
    if (not ui.isFocused(v)) { return }
    if (not ui.focusVisible) { return }
    ui.canvas.strokeRound(grow(v.frame, 2.5), rad + 2.5, 2.0, ui.theme.accentSoft)
}

// ------------------------------------------------------------------- icons

/// Icons drawn from strokes rather than loaded from a file, so that an
/// application has a set without carrying an asset — and so that they take the
/// colour and the weight they are drawn at, which a bitmap could not.
public proc drawIcon(var c: Canvas, name: String, r: Rect, col: Int, wt: Float) {
    if (isEmpty(r)) { return }
    val x = r.x
    val y = r.y
    val w = r.w
    val h = r.h
    val cx = x + w / 2.0
    val cy = y + h / 2.0
    val u = w.min(h)
    val q = u * 0.25

    if (name == "check") {
        c.line(cx - q * 1.5, cy, cx - q * 0.35, cy + q * 1.15, wt, col)
        c.line(cx - q * 0.35, cy + q * 1.15, cx + q * 1.6, cy - q * 1.2, wt, col)
        return
    }
    if (name == "close") {
        c.line(cx - q, cy - q, cx + q, cy + q, wt, col)
        c.line(cx + q, cy - q, cx - q, cy + q, wt, col)
        return
    }
    if (name == "plus") {
        c.line(cx - q * 1.2, cy, cx + q * 1.2, cy, wt, col)
        c.line(cx, cy - q * 1.2, cx, cy + q * 1.2, wt, col)
        return
    }
    if (name == "minus") {
        c.line(cx - q * 1.2, cy, cx + q * 1.2, cy, wt, col)
        return
    }
    if (name == "chevron-down") {
        c.line(cx - q, cy - q * 0.5, cx, cy + q * 0.6, wt, col)
        c.line(cx, cy + q * 0.6, cx + q, cy - q * 0.5, wt, col)
        return
    }
    if (name == "chevron-up") {
        c.line(cx - q, cy + q * 0.5, cx, cy - q * 0.6, wt, col)
        c.line(cx, cy - q * 0.6, cx + q, cy + q * 0.5, wt, col)
        return
    }
    if (name == "chevron-right") {
        c.line(cx - q * 0.5, cy - q, cx + q * 0.6, cy, wt, col)
        c.line(cx + q * 0.6, cy, cx - q * 0.5, cy + q, wt, col)
        return
    }
    if (name == "chevron-left") {
        c.line(cx + q * 0.5, cy - q, cx - q * 0.6, cy, wt, col)
        c.line(cx - q * 0.6, cy, cx + q * 0.5, cy + q, wt, col)
        return
    }
    if (name == "menu") {
        c.fillRound(Rect(cx - q * 1.3, cy - q * 1.1, q * 2.6, wt), wt / 2.0, col)
        c.fillRound(Rect(cx - q * 1.3, cy - wt / 2.0, q * 2.6, wt), wt / 2.0, col)
        c.fillRound(Rect(cx - q * 1.3, cy + q * 1.1 - wt, q * 2.6, wt), wt / 2.0, col)
        return
    }
    if (name == "dot") {
        c.fillCircle(cx, cy, u * 0.16, col)
        return
    }
    if (name == "search") {
        ring(c, cx - q * 0.25, cy - q * 0.25, q * 0.95, wt, col)
        c.line(cx + q * 0.45, cy + q * 0.45, cx + q * 1.35, cy + q * 1.35, wt, col)
        return
    }
    if (name == "play") {
        // A triangle, filled by three chords — enough at icon sizes.
        var i = 0
        val n = 14
        while (i <= n) {
            val f = i.toFloat() / n.toFloat()
            val half = q * 1.1 * (1.0 - f)
            c.line(cx - q * 0.8 + q * 2.0 * f, cy - half, cx - q * 0.8 + q * 2.0 * f, cy + half, wt * 0.9, col)
            i++
        }
        return
    }
    if (name == "pause") {
        c.fillRound(Rect(cx - q * 0.9, cy - q * 1.1, q * 0.6, q * 2.2), wt / 2.0, col)
        c.fillRound(Rect(cx + q * 0.3, cy - q * 1.1, q * 0.6, q * 2.2), wt / 2.0, col)
        return
    }
    if (name == "warning") {
        c.line(cx, cy - q * 1.2, cx - q * 1.3, cy + q * 1.1, wt, col)
        c.line(cx, cy - q * 1.2, cx + q * 1.3, cy + q * 1.1, wt, col)
        c.line(cx - q * 1.3, cy + q * 1.1, cx + q * 1.3, cy + q * 1.1, wt, col)
        c.fillCircle(cx, cy + q * 0.7, wt * 0.6, col)
        c.fillRound(Rect(cx - wt * 0.5, cy - q * 0.5, wt, q * 0.9), wt / 2.0, col)
        return
    }
    if (name == "folder") {
        c.strokeRound(Rect(cx - q * 1.4, cy - q * 0.9, q * 2.8, q * 1.9), wt * 1.2, wt, col)
        c.fillRound(Rect(cx - q * 1.4, cy - q * 1.3, q * 1.3, q * 0.6), wt, col)
        return
    }
    if (name == "file") {
        c.strokeRound(Rect(cx - q, cy - q * 1.3, q * 2.0, q * 2.6), wt * 1.2, wt, col)
        c.line(cx - q * 0.45, cy - q * 0.35, cx + q * 0.45, cy - q * 0.35, wt * 0.8, col)
        c.line(cx - q * 0.45, cy + q * 0.35, cx + q * 0.45, cy + q * 0.35, wt * 0.8, col)
        return
    }
    if (name == "trash") {
        c.line(cx - q * 1.2, cy - q * 0.8, cx + q * 1.2, cy - q * 0.8, wt, col)
        c.strokeRound(Rect(cx - q * 0.9, cy - q * 0.8, q * 1.8, q * 2.1), wt, wt, col)
        c.line(cx - q * 0.45, cy - q * 1.25, cx + q * 0.45, cy - q * 1.25, wt, col)
        return
    }
    if (name == "backspace") {
        // The tag shape everyone knows: a rectangle with a point on its left
        // and a cross inside it.
        c.line(cx - q * 1.5, cy, cx - q * 0.5, cy - q * 1.0, wt, col)
        c.line(cx - q * 1.5, cy, cx - q * 0.5, cy + q * 1.0, wt, col)
        c.line(cx - q * 0.5, cy - q * 1.0, cx + q * 1.5, cy - q * 1.0, wt, col)
        c.line(cx - q * 0.5, cy + q * 1.0, cx + q * 1.5, cy + q * 1.0, wt, col)
        c.line(cx + q * 1.5, cy - q * 1.0, cx + q * 1.5, cy + q * 1.0, wt, col)
        c.line(cx - q * 0.05, cy - q * 0.45, cx + q * 0.95, cy + q * 0.45, wt * 0.85, col)
        c.line(cx + q * 0.95, cy - q * 0.45, cx - q * 0.05, cy + q * 0.45, wt * 0.85, col)
        return
    }
    if (name == "gear") {
        ring(c, cx, cy, q * 1.15, wt, col)
        c.fillCircle(cx, cy, q * 0.4, col)
        return
    }
    // An unknown name draws a hollow square rather than nothing, so that a
    // typo is visible instead of silent.
    c.strokeRound(shrink(r, u * 0.2), u * 0.12, wt, col)
}

proc ring(var c: Canvas, cx: Float, cy: Float, rad: Float, wt: Float, col: Int) {
    c.strokeRound(Rect(cx - rad, cy - rad, rad * 2.0, rad * 2.0), rad, wt, col)
}
