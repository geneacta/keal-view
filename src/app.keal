import "./canvas.keal"
import "./color.keal"
import "./event.keal"
import "./ffi.keal"
import "./font.keal"
import "./geom.keal"
import "./layout.keal"
import "./paint.keal"
import "./popup.keal"
import "./state.keal"
import "./text.keal"
import "./theme.keal"
import "./ui.keal"
import "./view.keal"

/// The loop, and how what the user does gets back to the application.
///
/// A frame is: build the tree from the state, lay it out, hand it the events
/// that arrived, and — if handling them changed any `Cell` — build and lay it
/// out once more before drawing. Dispatching against a fresh layout rather
/// than the last frame's is what keeps a click landing on what was under the
/// pointer when it happened, even on the frame where the window was resized.
///
/// Between frames the loop is inside `kvWait`, which blocks until the system
/// has something to say. An idle keal-view window uses no processor at all —
/// not a low duty cycle, none — and that is worth more on a laptop than any
/// amount of drawing speed.

/// An application: a window, a look, and a function from state to a tree.
public class App(public var title: String, public var width: Int, public var height: Int) {
    /// Called to produce the interface. It is called again whenever a `Cell`
    /// is written, so it must be a function of the state and nothing else —
    /// no side effects, no counters, no reading the clock.
    public var build: () -> View = { -> label("set app.build") }
    /// A first look at the keyboard: every key press, and every typed
    /// character that no text field claimed. Answer true to say it was
    /// handled and stop it going further.
    public var onKey: (Event) -> Bool = { e -> false }
    /// Drawn over the interface, in the same rectangle, after everything
    /// else — and asked about the pointer before anything else. Menus,
    /// dialogs, tooltips and the ghost under a drag live here.
    public var overlay: () -> View = { -> nothing() }
    /// Called once the window is open and the fonts are loaded, before the
    /// first frame.
    public var onStart: () -> Unit = { -> }
    /// Called when the window is closed, before the process ends.
    public var onStop: () -> Unit = { -> }
}

/// Open the window and run until it is closed.
///
/// Every keal-view program also understands
/// `--snapshot <file.bmp> [scale] [width height]` on its command line, which
/// draws one frame to a file and exits without opening anything. That is how the examples in the README are made and how
/// the widgets are checked on a machine with no display — the same code path
/// the window uses, minus the window.
public proc run(var app: App) {
    val argv = args()
    if (argv.size >= 2) {
        if (argv[0] == "--snapshot") {
            var sc = 2.0
            if (argv.size >= 3) { sc = argv[2].toFloat() ?: 2.0 }
            var w = app.width
            var h = app.height
            // A size may be given, so that a page taller than its window can
            // be photographed whole for the documentation.
            if (argv.size >= 5) {
                w = argv[3].toInt() ?: w
                h = argv[4].toInt() ?: h
            }
            snapshot(app, w, h, sc, argv[1])
            return
        }
    }
    // Said before the window opens, because one platform can only hear it then.
    kvPreferDark(theme().dark)
    if (kvOpen(app.title, app.width, app.height) == 0) {
        println("keal-view: the platform would not open a window")
        return
    }
    kvSetDark(theme().dark)
    var wasDark = theme().dark
    val fonts = systemFonts()
    if (fonts.sans == null) {
        println("keal-view: no system font could be read — text will not be drawn")
    }
    val canvas = Canvas()
    val ui = Ui(canvas, fonts, theme())
    val t0 = kvNow()
    // `--window-id <file>` writes the system's number for this window into a
    // file, so that a script outside the process can point `screencapture -l`
    // at exactly this window. A file rather than stdout because stdout is
    // block-buffered when it is not a terminal, and a reader would find it
    // empty until the program ended.
    var i0 = 0
    while (i0 + 1 < argv.size) {
        if (argv[i0] == "--window-id") { writeFile(argv[i0 + 1], kvWindowId().toString()) }
        i0++
    }
    app.onStart()

    // `--trace <file>` writes one line a second: how many frames were drawn,
    // how many events arrived and of what kind, and how many of those frames
    // were asked for by an animation rather than by something happening. A
    // window at rest should draw **nothing**, so a non-zero frame count here
    // with no events is the whole diagnosis of a loop that is spinning — and
    // the kind histogram names what is waking it when there is.
    var tracePath = ""
    var t0i = 0
    while ((t0i + 1) < argv.size) {
        if (argv[t0i] == "--trace") { tracePath = argv[t0i + 1] }
        t0i++
    }
    var traceLog = ""
    if (tracePath != "") {
        // A header, because the interesting result is silence. A window at
        // rest draws nothing, so it writes nothing, and an empty file would
        // otherwise be indistinguishable from an instrument that is not
        // running. One line at the start says it is.
        traceLog = "trace started — a line per second in which a frame was drawn;\n"
        traceLog = traceLog + "silence means the window drew nothing, which is what rest looks like.\n"
        writeFile(tracePath, traceLog)
    }
    var traceMark = 0.0
    var traceFrames = 0
    var traceWakes = 0
    var traceAnimated = 0
    val traceKinds: List<Int> = []
    var ki = 0
    while (ki < 13) { traceKinds.add(0); ki++ }

    var running = true
    var lastRev = -1
    var lastDrawn = -1
    var lastW = -1
    var lastH = -1
    var haveTree = false
    var root = nothing()
    while (running) {
        ui.time = kvNow() - t0
        ui.theme = theme()
        // The system draws the title bar, so it has to be told when the
        // application's own idea of light and dark changed.
        if (theme().dark != wasDark) {
            wasDark = theme().dark
            kvSetDark(wasDark)
        }

        // Everything the system has to say, taken in one go: a burst of mouse
        // moves should cost one frame, not one frame each.
        val events: List<Event> = []
        var draining = true
        while (draining) {
            val e = nextEvent(kvScale())
            if (e == null) {
                draining = false
            } else {
                if (e.kind == evClose()) { running = false }
                events.add(e)
            }
        }

        kvSurface(kvWidth(), kvHeight())
        canvas.begin(kvSurfaceW(), kvSurfaceH(), kvScale())
        val area = canvas.bounds()
        val sizeChanged = (kvSurfaceW() != lastW) or (kvSurfaceH() != lastH)

        // Build and lay out only when the answer would differ.
        //
        // The tree is a function of the state and of the room it has, so if
        // neither moved since the last time round, the tree from last time is
        // the tree this time — including every rectangle in it, which is what
        // the pointer is about to be tested against. Rebuilding it anyway was
        // the whole of the residual cost: a wake-up that changed nothing still
        // walked the application's view function and laid the result out, at a
        // price set by how much content there is. Two windows of exactly the
        // same size, a calculator and a scrolling document, differed by
        // twenty-two times — which is what says it is the tree and not the
        // pixels.
        if ((not haveTree) or ((revision() != lastRev) or sizeChanged)) {
            root = stack([app.build(), app.overlay(), popupLayer()])
            layout(ui, root, area)
            lastRev = revision()
            haveTree = true
        }
        // `deliver` rebuilds inside itself whenever a handler changes anything,
        // so what it answers is current whatever happened during it.
        root = deliver(ui, app, root, area, events)
        lastRev = revision()

        // Draw only when there is something different to draw.
        //
        // The loop wakes for anything the system has to say, and most of what
        // it says changes nothing: a pointer crossing a window over a static
        // interface used to repaint every pixel of it, which on a large window
        // is a hundred milliseconds of work to produce the identical image. On
        // Windows that had a second consequence — the frame woke the wait that
        // drew the frame, and an idle window under a stationary pointer held a
        // whole core — but the waste was there on every platform, unnoticed
        // because it only cost battery.
        //
        // A frame is stale when a `Cell` was written, when a widget's own
        // state moved (hover, focus, a caret), when the window changed size,
        // or when something asked to be woken. All of those go through
        // `invalidate` or `wakeIn`, so this one comparison covers them.
        val stale = (revision() != lastDrawn) or (sizeChanged or ui.animating())
        ui.nextFrameIn = -1.0
        if (stale) {
            // The theme, again, here. A handler may have changed it during
            // this very frame — the tree was then rebuilt in the new one while
            // `ui.theme`, read at the top of the loop, still held the old.
            // Colours resolved at build time came out right and colours
            // resolved at paint time came out wrong: white text on white. And
            // because a window at rest is not woken, the wrong image was the
            // one the user kept looking at.
            ui.theme = theme()
            canvas.begin(kvSurfaceW(), kvSurfaceH(), kvScale())
            canvas.clear(theme().bg)
            paint(ui, root)
            kvSetCursor(ui.cursor)
            kvFlush()
            lastDrawn = revision()
            lastW = kvSurfaceW()
            lastH = kvSurfaceH()
        }

        if (tracePath != "") {
            if (stale) { traceFrames = traceFrames + 1 }
            traceWakes = traceWakes + 1
            if (ui.animating()) { traceAnimated = traceAnimated + 1 }
            var ei = 0
            while (ei < events.size) {
                val k = clampI(events[ei].kind, 0, 12)
                traceKinds[k] = traceKinds[k] + 1
                ei++
            }
            if (((ui.time - traceMark) >= 1000.0) and (traceWakes > 0)) {
                traceLog = traceLog +
                    traceLine(traceWakes, traceFrames, traceAnimated, traceKinds) + "\n"
                writeFile(tracePath, traceLog)
                traceMark = ui.time
                traceFrames = 0
                traceWakes = 0
                traceAnimated = 0
                var zi = 0
                while (zi < traceKinds.size) { traceKinds[zi] = 0; zi++ }
            }
        }

        if (running) {
            // Something that asked for a frame says when it wants it; anything
            // else waits for the user, for as long as that takes.
            if (ui.animating()) { kvWait(ui.nextFrameIn.round().max(1)) }
            else { kvWait(-1) }
        }
    }
    app.onStop()
    kvClose()
}

// ---------------------------------------------------------------- delivery

/// Hand a batch of events to a tree, rebuilding whenever a handler changes
/// anything, and answer the tree that is current afterwards.
///
/// The rebuild in the middle is not an optimisation, it is the correctness.
/// A view holds the state as it was when the frame began — a text field's
/// `label` is a photograph — and a handler computes the new state from it. Two
/// events in one batch would then both read the same photograph and the second
/// would overwrite the first: type three characters faster than the loop draws
/// and two of them are lost. It was found that way, at about one character in
/// three, by someone typing at a machine.
///
/// This is the unit the run loop uses and the unit a test should use. Calling
/// `dispatch` in a row and patching the state up in between tests a world that
/// has already caught up, which is not the world an application runs in.
public func deliver(var ui: Ui, var app: App, var root: View, area: Rect,
                    events: List<Event>): View {
    var tree = root
    var i = 0
    while (i < events.size) {
        val before = revision()
        dispatch(ui, app, tree, events[i])
        if (revision() != before) {
            tree = stack([app.build(), app.overlay(), popupLayer()])
            layout(ui, tree, area)
        }
        i++
    }
    return tree
}

// ---------------------------------------------------------------- dispatch

/// Route one event into the tree.
public proc dispatch(var ui: Ui, var app: App, var root: View, e: Event) {
    ui.pointer.apply(e)
    val k = e.kind

    if (k == evMove()) {
        val h = hit(root, e.x, e.y)
        val newHot = if (h == null) { 0 } else { h.id }
        // Everything the pointer is inside, not only what it can click: a view
        // that paints itself is told whether it is under the pointer, and a
        // chart is under it whether or not it takes a click.
        val path: List<Int> = []
        hoverPath(root, e.x, e.y, path)
        val deepBefore = if (ui.hoverIds.size == 0) { 0 } else { ui.hoverIds[ui.hoverIds.size - 1] }
        val deepNow = if (path.size == 0) { 0 } else { path[path.size - 1] }
        ui.hoverIds = path
        if (deepNow != deepBefore) { invalidate() }
        if (newHot != ui.hot) {
            ui.hot = newHot
            invalidate()
        } else {
            // Two widgets draw from where the pointer *is*, not merely from
            // which node it is over: a tab strip and a segmented control each
            // light the one segment under it. Moving inside them changes what
            // should be on screen without changing what is hot, so they have
            // to say so or the highlight would stick to whichever segment the
            // pointer entered by.
            if (h != null) {
                if ((h.kind == kTabs) or (h.kind == kSegmented)) { invalidate() }
            }
        }
        if (ui.active != 0) { drag(ui, root, e) }
        setCursor(ui, root, e)
        tipUnder(ui, root, e)
        return
    }

    if (k == evDown()) {
        ui.focusVisible = false
        val h = hit(root, e.x, e.y)
        if (h == null) {
            ui.active = 0
            if (ui.focus != 0) { ui.focus = 0; invalidate() }
            return
        }
        ui.active = h.id
        // A press has not yet become a drag. Which of the two it turns out to
        // be decides whether letting go is a click or a drop.
        ui.setMemo(mixId(h.id, 9), 0.0)
        if (h.draggable) { h.onGrab(e.x, e.y) }
        ui.hot = h.id
        // Only a text field keeps the keyboard after a click. A button that
        // took focus on click would leave a ring behind it, which is what
        // every toolkit that does this is criticised for.
        val wantFocus = if (h.kind == kField) { h.id } else { 0 }
        if (wantFocus != ui.focus) { ui.focus = wantFocus }
        if (h.kind == kField) {
            caretToPointer(ui, h, e, false)
            // Two clicks take the word, three take the line.
            if (e.clicks == 2) {
                val w = wordAround(h.label, ui.caretOf(h.id, 0))
                ui.setAnchor(h.id, w.x.toInt())
                ui.setCaret(h.id, w.y.toInt())
            }
            if (e.clicks >= 3) {
                ui.setAnchor(h.id, 0)
                ui.setCaret(h.id, h.label.length)
            }
        }
        if (h.kind == kSlider) { sliderToPointer(ui, h, e.x) }
        if (h.kind == kTabs) { tabAt(ui, h, e.x) }
        if (h.kind == kSegmented) { segmentAt(ui, h, e.x) }
        invalidate()
        return
    }

    if (k == evUp()) {
        val id = ui.active
        ui.active = 0
        if (id == 0) { return }
        invalidate()
        val n = nodeById(root, id)
        if (n == null) { return }
        if (ui.memoOf(mixId(id, 9), 0.0) > 0.5) {
            n.onDragEnd(e.x, e.y)
            ui.setMemo(mixId(id, 9), 0.0)
            return
        }
        if (not holds(n.frame, e.x, e.y)) { return }
        fire(n)
        return
    }

    if (k == evScroll()) {
        val s = scrollUnder(root, e.x, e.y)
        if (s == null) { return }
        val room = (s.content - s.frame.h).max(0.0)
        val was = ui.scrollOf(s.id)
        val now = clampF(was - e.dy, 0.0, room)
        if (now != was) { ui.setScroll(s.id, now); invalidate() }
        return
    }

    if (k == evText()) {
        // The application sees typing before the widgets do, so that a
        // calculator can take a digit from the keyboard whether or not
        // anything is focused — and a text field still wins, because an
        // application that has one usually wants the character to go there.
        val f = focusedField(ui, root)
        if (f == null) {
            app.onKey(e)
            return
        }
        insert(ui, f, e.text)
        return
    }

    if (k == evKeyDown()) {
        if (app.onKey(e)) { return }
        keyDown(ui, root, e)
        return
    }

    // Everything that changes what is on the screen without changing the
    // application's own state: the window came back from behind another one,
    // it changed size, it gained or lost the focus ring. Each has to mark the
    // frame stale itself, because nothing else will.
    if ((k == evBlur()) or ((k == evFocus()) or ((k == evResize()) or (k == evExpose())))) {
        invalidate()
    }
}

/// What a click on a finished press means, per kind. A checkbox and a toggle
/// report the value they *would* become, not the one they have: the view is
/// rebuilt from the application's state, so the control never flips itself.
proc fire(var n: View) {
    if (n.clickable) { n.onTap(); return }
    if (n.kind == kButton) { n.onTap(); return }
    if (n.kind == kCheck) { n.onBool(not n.on); return }
    if (n.kind == kToggle) { n.onBool(not n.on); return }
    if (n.kind == kRadio) { n.onTap(); return }
}

proc drag(var ui: Ui, var root: View, e: Event) {
    val a = nodeById(root, ui.active)
    if (a == null) { return }
    if (a.kind == kSlider) { sliderToPointer(ui, a, e.x); return }
    if (a.kind == kField) {
        // A press that has not really moved is not a drag. The mouse move that
        // arrives between the two clicks of a double click would otherwise
        // snap the caret back to the pointer and undo the word the second
        // click had just selected — which is what it did.
        if (ui.pointer.dragged() < 3.0) { return }
        caretToPointer(ui, a, e, true)
        return
    }
    if (a.draggable) {
        val dx = e.x - ui.pointer.downX
        val dy = e.y - ui.pointer.downY
        // Three points of slop, so that a click with a shaky hand is still a
        // click and not a one-pixel drag.
        if (ui.memoOf(mixId(a.id, 9), 0.0) < 0.5) {
            if ((dx * dx + dy * dy).sqrt() < 3.0) { return }
            ui.setMemo(mixId(a.id, 9), 1.0)
        }
        a.onDrag(e.x, e.y)
        invalidate()
        return
    }
}

/// Show the note attached to whatever the pointer is resting on, and take it
/// away as soon as the pointer is somewhere else.
proc tipUnder(var ui: Ui, root: View, e: Event) {
    val h = tipAt(root, e.x, e.y)
    if (h == null) { hideTip(); return }
    showTip(e.x + 14.0, e.y + 18.0, h.tipText)
}

proc setCursor(var ui: Ui, root: View, e: Event) {
    // While a drag is under way the shape belongs to what is being dragged,
    // not to whatever the pointer happens to be over.
    if (ui.active != 0) {
        val a = nodeById(root, ui.active)
        if (a != null) {
            if (a.cursor >= 0) { ui.wantCursor(a.cursor); return }
        }
    }
    val h = hit(root, e.x, e.y)
    if (h == null) { ui.wantCursor(cursorArrow()); return }
    if (h.cursor >= 0) { ui.wantCursor(h.cursor); return }
    if (h.kind == kField) { ui.wantCursor(cursorText()); return }
    ui.wantCursor(cursorArrow())
}

// ------------------------------------------------------------- the widgets

proc sliderToPointer(var ui: Ui, var v: View, x: Float) {
    val kn = sliderKnob(ui.theme)
    val x0 = v.frame.x + kn
    val span = (v.frame.w - kn * 2.0).max(1.0)
    var f = clampF((x - x0) / span, 0.0, 1.0)
    var value = v.lo + (v.hi - v.lo) * f
    if (v.step > 0.0) { value = v.lo + ((value - v.lo) / v.step).round().toFloat() * v.step }
    value = clampF(value, v.lo.min(v.hi), v.lo.max(v.hi))
    if (value != v.value) { v.onFloat(value) }
}

proc segmentAt(var ui: Ui, var v: View, x: Float) {
    val n = v.options.size
    if (n == 0) { return }
    val inner = shrink(v.frame, ui.theme.gap(0.75))
    val i = clampI(floorI((x - inner.x) / (inner.w / n.toFloat())), 0, n - 1)
    if (i != v.index) { v.onIndex(i) }
}

proc tabAt(var ui: Ui, var v: View, x: Float) {
    val t = ui.theme
    val st = ui.styleFor(v)
    val sc = ui.canvas.scale
    var cx = v.frame.x
    var i = 0
    while (i < v.options.size) {
        val w = ui.fonts.width(v.options[i], st, sc) + t.gap(5.0)
        if ((x >= cx) and (x < cx + w)) {
            if (i != v.index) { v.onIndex(i) }
            return
        }
        cx = cx + w
        i++
    }
}

func focusedField(ui: Ui, root: View): View? {
    if (ui.focus == 0) { return null }
    val n = nodeById(root, ui.focus)
    if (n == null) { return null }
    if (n.kind != kField) { return null }
    if (not n.enabled) { return null }
    return n
}

proc caretToPointer(var ui: Ui, var v: View, e: Event, extend: Bool) {
    val st = ui.styleFor(v)
    val sc = ui.canvas.scale
    val padX = ui.theme.gap(2.5)
    val shift = ui.memoOf(mixId(v.id, 5), 0.0)
    val shown = if (v.password) { "•".repeat(v.label.length) } else { v.label }
    val at = ui.fonts.indexAt(shown, e.x - v.frame.x - padX + shift, st, sc)
    ui.setCaret(v.id, at)
    if (not extend) { ui.setAnchor(v.id, at) }
    invalidate()
}

/// The current selection, as an ordered pair of character offsets.
func selOf(ui: Ui, v: View): Rect {
    val n = v.label.length
    val car = clampI(ui.caretOf(v.id, n), 0, n)
    val anc = clampI(ui.anchorOf(v.id, car), 0, n)
    return Rect(car.min(anc).toFloat(), car.max(anc).toFloat(), 0.0, 0.0)
}

proc insert(var ui: Ui, var v: View, s: String) {
    if (s == "") { return }
    val sel = selOf(ui, v)
    val a = sel.x.toInt()
    val b = sel.y.toInt()
    v.onString(v.label.take(a) + s + v.label.drop(b))
    ui.setCaret(v.id, a + s.length)
    ui.setAnchor(v.id, a + s.length)
    invalidate()
}

proc deleteSel(var ui: Ui, var v: View, backwards: Bool) {
    val sel = selOf(ui, v)
    var a = sel.x.toInt()
    var b = sel.y.toInt()
    if (a == b) {
        if (backwards) { a = (a - 1).max(0) } else { b = (b + 1).min(v.label.length) }
    }
    if (a == b) { return }
    v.onString(v.label.take(a) + v.label.drop(b))
    ui.setCaret(v.id, a)
    ui.setAnchor(v.id, a)
    invalidate()
}

proc moveCaret(var ui: Ui, var v: View, to: Int, extend: Bool) {
    val n = v.label.length
    val from = clampI(ui.caretOf(v.id, n), 0, n)
    val at = clampI(to, 0, n)
    // Extending needs somewhere to extend *from*. A field reached by Tab has
    // never been clicked, so it has no anchor, and `anchorOf` would answer the
    // caret — which is where the caret is going, so the selection would be
    // empty however far it ran. Pin the anchor where the caret was.
    if (extend) { ui.setAnchor(v.id, clampI(ui.anchorOf(v.id, from), 0, n)) }
    else { ui.setAnchor(v.id, at) }
    ui.setCaret(v.id, at)
    invalidate()
}

/// The run of letters or digits around `at`, as an ordered pair. What a double
/// click selects.
func wordAround(s: String, at: Int): Rect {
    val cs = s.chars()
    if (cs.size == 0) { return Rect(0.0, 0.0, 0.0, 0.0) }
    var a = clampI(at, 0, cs.size)
    if ((a >= cs.size) or (not wordish(cs[a]))) { a = (a - 1).max(0) }
    if (not wordish(cs[a])) { return Rect(at.toFloat(), at.toFloat(), 0.0, 0.0) }
    var b = a
    while ((a > 0) and wordish(cs[a - 1])) { a-- }
    while (((b + 1) < cs.size) and wordish(cs[b + 1])) { b++ }
    return Rect(a.toFloat(), (b + 1).toFloat(), 0.0, 0.0)
}

func wordish(c: String): Bool {
    if ((c >= "0") and (c <= "9")) { return true }
    val l = c.toLower()
    if ((l >= "a") and (l <= "z")) { return true }
    // Anything above ASCII is a letter as far as a double click is concerned:
    // guessing otherwise would break every language that has accents.
    return c.code() > 127
}

// ------------------------------------------------------------- the keyboard

proc keyDown(var ui: Ui, var root: View, e: Event) {
    val key = e.key

    // Escape puts away whatever is over the interface before it reaches it.
    if (key == keyEscape()) {
        if (popupOpen()) { closePopup(); return }
    }

    if (key == keyTab()) {
        moveFocus(ui, root, not e.shift())
        return
    }

    val f = focusedField(ui, root)
    if (f == null) {
        // With no field focused, Space and Return work the focused control,
        // which is what makes the whole interface reachable from the keyboard.
        if (ui.focus == 0) { return }
        val n = nodeById(root, ui.focus)
        if (n == null) { return }
        if ((key == keyEnter()) or (key == keySpace())) { fire(n); invalidate() }
        if (key == keyEscape()) { ui.focus = 0; invalidate() }
        return
    }

    val n = f.label.length
    val car = clampI(ui.caretOf(f.id, n), 0, n)
    val sel = selOf(ui, f)

    if (e.cmd()) {
        if (e.text == "a") { ui.setAnchor(f.id, 0); ui.setCaret(f.id, n); invalidate(); return }
        if ((e.text == "c") or (e.text == "x")) {
            if (sel.x != sel.y) {
                kvClipboardSet(f.label.substring(sel.x.toInt(), sel.y.toInt()))
                if (e.text == "x") { deleteSel(ui, f, true) }
            }
            return
        }
        if (e.text == "v") { insert(ui, f, kvClipboardGet().replace("\n", " ")); return }
    }

    if (key == keyBackspace()) { deleteSel(ui, f, true); return }
    if (key == keyDelete()) { deleteSel(ui, f, false); return }
    if (key == keyLeft()) { moveCaret(ui, f, car - 1, e.shift()); return }
    if (key == keyRight()) { moveCaret(ui, f, car + 1, e.shift()); return }
    if (key == keyHome()) { moveCaret(ui, f, 0, e.shift()); return }
    if (key == keyEnd()) { moveCaret(ui, f, n, e.shift()); return }
    if (key == keyEscape()) { ui.focus = 0; invalidate(); return }
    if (key == keyEnter()) { f.onTap(); invalidate(); return }
}

proc moveFocus(var ui: Ui, var root: View, forward: Bool) {
    val list: List<View> = []
    focusables(root, list)
    if (list.size == 0) { return }
    var at = -1
    var i = 0
    while (i < list.size) {
        if (list[i].id == ui.focus) { at = i }
        i++
    }
    var next = 0
    if (at < 0) {
        next = if (forward) { 0 } else { list.size - 1 }
    } else {
        next = (at + (if (forward) { 1 } else { list.size - 1 })) % list.size
    }
    ui.focus = list[next].id
    ui.focusVisible = true
    invalidate()
}

// ------------------------------------------------------------------ offscreen

/// Draw one frame of an application to a BMP file, with no window and no
/// display. The tree is built, laid out and painted by exactly the code the
/// window uses; only the surface is different.
public proc snapshot(var app: App, w: Int, h: Int, scale: Float, path: String) {
    val fonts = systemFonts()
    val canvas = canvasOffscreen(w, h, scale)
    val ui = Ui(canvas, fonts, theme())
    app.onStart()
    val root = stack([app.build(), app.overlay(), popupLayer()])
    val area = canvas.bounds()
    layout(ui, root, area)
    canvas.clear(theme().bg)
    paint(ui, root)
    if (kvSaveBmp(path) == 0) { println("keal-view: could not write ${path}") }
    app.onStop()
}

/// The shortest way to a window.
///
///     runApp("Hello", 320, 200, { ->
///         column([label("hello")]).padAll(24.0)
///     })
///
/// Everything `App` can be told is still there when it is wanted — a theme,
/// an overlay, a key handler, something to do on start. This is the two lines
/// of ceremony removed for the case that does not want them.
public proc runApp(title: String, w: Int, h: Int, build: () -> View) {
    val app = App(title, w, h)
    app.build = build
    run(app)
}

/// One line of the trace: how many times the loop woke, how many of those
/// wakes drew anything, how many frames an animation asked for, and the events
/// that arrived, by name. Kinds with no events are left out, so a quiet second
/// is a short line and a flood names itself.
///
/// `wakes` far above `frames` is the loop being woken for things that change
/// nothing — which is fine and costs almost nothing. `frames` climbing with
/// `events` one for one is a loop feeding itself.
func traceLine(wakes: Int, frames: Int, animated: Int, kinds: List<Int>): String {
    val names = ["none", "close", "resize", "move", "down", "up", "scroll",
                 "keydown", "keyup", "text", "focus", "blur", "expose"]
    var evs = ""
    var i = 0
    var total = 0
    while (i < kinds.size) {
        if (kinds[i] > 0) {
            evs = evs + " " + names[i] + "=" + kinds[i].toString()
            total = total + kinds[i]
        }
        i++
    }
    if (total == 0) { evs = " (no events)" }
    return "wakes=" + wakes.toString() + " frames=" + frames.toString() +
           " animated=" + animated.toString() + " events=" + total.toString() + evs
}
