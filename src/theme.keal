import "./canvas.keal"
import "./color.keal"
import "./geom.keal"
import "./state.keal"
import "./text.keal"

/// What an application looks like, in one object.
///
/// Nothing in the widgets hard-codes a colour or a corner radius; they read
/// them from here. That is what makes a theme a value an application can swap
/// at run time, and what makes it possible to say that keal-view has *a* look
/// rather than that each control has one.
///
/// The palettes are built from a small number of decisions rather than from a
/// list of hex codes: one surface ramp, one accent, three status hues, and a
/// text ramp of three weights. Adding a colour to a theme should be rare, and
/// should have to justify itself.
public class Theme {
    /// Behind everything.
    public var bg: Int = 0
    /// A panel, a card, a menu — one step up from the background.
    public var surface: Int = 0
    /// A row that is hovered, a field, an inset well — one step further.
    public var surfaceHi: Int = 0
    /// A pressed control.
    public var surfaceDown: Int = 0
    /// Hairlines between regions.
    public var border: Int = 0
    /// A border that has to be seen: a focused field, a selected tab.
    public var borderStrong: Int = 0

    /// Body text and headings.
    public var textPrimary: Int = 0
    /// Labels, secondary rows.
    public var textSecondary: Int = 0
    /// Placeholders, disabled things, watermarks.
    public var textMuted: Int = 0
    /// Text on top of `accent`.
    public var textOnAccent: Int = 0

    /// The one colour the application is about.
    public var accent: Int = 0
    public var accentHover: Int = 0
    public var accentDown: Int = 0
    /// The accent at low opacity — a selected row, a focus halo.
    public var accentSoft: Int = 0
    /// Behind selected text. Stronger than `accentSoft`: a focus ring may be
    /// a hint, but a selection has to be legible at a glance or it is not
    /// telling you anything.
    public var selection: Int = 0

    public var success: Int = 0
    public var warning: Int = 0
    public var danger: Int = 0

    /// What a shadow is made of. Darker and more opaque on a light theme,
    /// because a shadow on a dark surface reads as an absence, not a mark.
    public var shadow: Int = 0

    public var radiusSm: Float = 4.0
    public var radiusMd: Float = 8.0
    public var radiusLg: Float = 14.0
    /// Large enough that any control becomes a capsule.
    public var radiusPill: Float = 999.0

    /// The spacing grid. Every gap and padding in the widgets is a multiple.
    public var unit: Float = 4.0
    /// One hairline, in points. Not 1.0 device pixels — a hairline should be
    /// the same *thickness* on every display, and the rasteriser will put it
    /// on two physical pixels at 2× where that is what a point is.
    public var hairline: Float = 1.0

    public var fontSm: Float = 11.0
    public var fontBase: Float = 13.0
    public var fontLg: Float = 16.0
    public var fontTitle: Float = 22.0

    /// The height a button, a field or a menu row occupies.
    public var control: Float = 30.0
    /// The height of a docking tab strip and a title bar.
    public var strip: Float = 32.0
    public var dark: Bool = true

    public func gap(n: Float): Float { return this.unit * n }
    public func body(): TextStyle { return text(this.fontBase) }
    public func small(): TextStyle { return text(this.fontSm) }
    public func heading(): TextStyle { return textBold(this.fontLg) }
    public func title(): TextStyle { return textBold(this.fontTitle) }
}

// ------------------------------------------------------- the one in force

var current: Theme = darkTheme()

/// The theme the application is using. Everything that needs one takes it as
/// a defaulted argument, so a widget, a panel or a whole example can be
/// written without ever mentioning a theme — and one call changes all of it.
public func theme(): Theme { return current }

/// Change it. The next frame is drawn in the new one.
public proc useTheme(t: Theme) {
    current = t
    invalidate()
}

/// Swap between the two built-in palettes.
public proc flipTheme() {
    useTheme(if (current.dark) { lightTheme() } else { darkTheme() })
}

/// The dark palette: a near-neutral slate ramp with a blue accent, tuned so
/// that `textSecondary` on `surface` clears 4.5:1 and `textMuted` clears 3:1.
public func darkTheme(): Theme {
    val t = Theme()
    t.dark = true
    t.bg = web("#0e1014")
    t.surface = web("#171a21")
    t.surfaceHi = web("#1f232c")
    t.surfaceDown = web("#282d38")
    t.border = web("#2a2f3a")
    t.borderStrong = web("#3d4451")
    t.textPrimary = web("#e8ebf0")
    t.textSecondary = web("#a4adbd")
    t.textMuted = web("#6d7686")
    t.textOnAccent = web("#ffffff")
    t.accent = web("#3b82f6")
    t.accentHover = web("#5c99f8")
    t.accentDown = web("#2f6fd8")
    t.accentSoft = rgba(59, 130, 246, 46)
    t.selection = rgba(59, 130, 246, 110)
    t.success = web("#34d399")
    t.warning = web("#fbbf24")
    t.danger = web("#f87171")
    t.shadow = rgba(0, 0, 0, 190)
    return t
}

/// The light palette. Not the dark one inverted: a light interface needs a
/// darker accent to stay legible on white and a much lighter shadow to stop
/// looking like dirt.
public func lightTheme(): Theme {
    val t = Theme()
    t.dark = false
    t.bg = web("#f4f5f7")
    t.surface = web("#ffffff")
    t.surfaceHi = web("#eef0f4")
    t.surfaceDown = web("#e2e6ec")
    t.border = web("#dfe3e9")
    t.borderStrong = web("#b9c0cb")
    t.textPrimary = web("#14171d")
    t.textSecondary = web("#4d5563")
    t.textMuted = web("#858d9b")
    t.textOnAccent = web("#ffffff")
    t.accent = web("#2563eb")
    t.accentHover = web("#3b82f6")
    t.accentDown = web("#1d4ed8")
    t.accentSoft = rgba(37, 99, 235, 34)
    t.selection = rgba(37, 99, 235, 90)
    t.success = web("#059669")
    t.warning = web("#d97706")
    t.danger = web("#dc2626")
    t.shadow = rgba(15, 23, 42, 60)
    return t
}

/// What a view that paints itself is handed.
///
/// A canvas alone would not be enough: text needs a font, and a widget that
/// draws its own chrome needs the theme, or every custom view would carry its
/// own idea of what a border looks like.
public class Paint(
    public val canvas: Canvas,
    /// The view's own rectangle, in points. The canvas is already clipped to it.
    public val area: Rect,
    public val fonts: Fonts,
    public val theme: Theme,
    /// Whether the pointer is over this view, and whether it is pressed on
    /// it — so a view that paints itself can react like the built-in ones.
    public val hot: Bool,
    public val pressed: Bool
) {
    public func scale(): Float { return this.canvas.scale }

    /// One line of text in a box: aligned across, centred down, and cut with
    /// an ellipsis if it does not fit.
    public proc text(s: String, r: Rect, align: Int, st: TextStyle, col: Int) {
        this.fonts.drawIn(this.canvas, s, r, align, st, col)
    }

    /// One line of text on a baseline, answering where the pen ended.
    public func line(s: String, x: Float, baseline: Float, st: TextStyle, col: Int): Float {
        return this.fonts.draw(this.canvas, s, x, baseline, st, col)
    }

    public func width(s: String, st: TextStyle): Float {
        return this.fonts.width(s, st, this.canvas.scale)
    }

    public func lineHeight(st: TextStyle): Float {
        return this.fonts.lineHeight(st, this.canvas.scale)
    }

    public func ascent(st: TextStyle): Float {
        return this.fonts.ascent(st, this.canvas.scale)
    }
}
