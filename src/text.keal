import "./canvas.keal"
import "./color.keal"
import "./font.keal"
import "./geom.keal"

/// Laying text out: measuring it, fitting it, and putting it on a canvas.
///
/// Everything here measures in logical points and converts to device pixels
/// only to ask the font engine for a glyph — which is rasterised at the size
/// it will actually be drawn, so a Retina screen gets a Retina glyph rather
/// than a stretched one. The pen advances in device pixels as a `Float` and is
/// rounded only when a glyph is blitted, which keeps a line's total width
/// honest while every glyph still lands on the pixel grid.

/// How text should look: a size in points, and which of the three faces.
public record TextStyle(public val size: Float, public val bold: Bool, public val mono: Bool)

public func text(size: Float): TextStyle { return TextStyle(size, false, false) }
public func textBold(size: Float): TextStyle { return TextStyle(size, true, false) }
public func textMono(size: Float): TextStyle { return TextStyle(size, false, true) }

/// One line of wrapped text, as offsets into the string it came from:
/// `[start, end)` are its characters, and `hard` says the break after it was a
/// newline the author typed rather than the column running out.
public record Line(public val start: Int, public val end: Int, public val hard: Bool)

/// The lines an author typed, and no others — `wrapLines` at a column
/// nothing reaches, arrived at without asking the font anything.
///
/// `wrapLines` measures every character to find out where a line runs out
/// of room. An editor that does not fold has no column to run out of, so
/// all that measuring produces the newlines that were already there. On a
/// five-thousand-line file that was **66 ms of every keystroke**, spent
/// discovering that a break happens where a break was typed.
///
/// The two must agree exactly, and are asserted to over the same strings
/// the wrapping invariants use — the offsets a caret, a selection, a hit
/// test and a coloured run all stand on come from one or the other
/// depending on a flag, and a flag that changes what an offset means would
/// be the worst defect in this file.
public func hardLines(s: String): List<Line> {
    val out: List<Line> = []
    val cs = s.chars()
    var start = 0
    var i = 0
    while (i < cs.size) {
        if (cs[i] == "\n") {
            out.add(Line(start, i, true))
            start = i + 1
        }
        i++
    }
    out.add(Line(start, cs.size, false))
    return out
}

/// Which line an offset falls on. Offsets are given to the earlier line where
/// two could claim one — see `wrapLines`, which arranges for that to happen
/// only mid-word.
public func lineOfOffset(lines: List<Line>, off: Int): Int {
    var i = 0
    while (i < lines.size) {
        if (off <= lines[i].end) { return i }
        i++
    }
    return (lines.size - 1).max(0)
}

/// Horizontal placement inside a box.
public func alignStart(): Int { return 0 }
public func alignCenter(): Int { return 1 }
public func alignEnd(): Int { return 2 }

/// The three faces an application draws with, and everything that needs them.
public class Fonts(public var sans: Font?, public var boldFace: Font?, public var mono: Font?) {

    /// The face a style asks for, falling back to whatever is loaded — a
    /// missing bold is better shown as regular than as nothing.
    public func faceFor(st: TextStyle): Font? {
        if (st.mono) {
            val m = this.mono
            if (m != null) { return m }
        }
        if (st.bold) {
            val b = this.boldFace
            if (b != null) { return b }
        }
        val s = this.sans
        if (s != null) { return s }
        return this.boldFace ?: this.mono
    }

    /// How wide the string is, in points, at `scale` device pixels per point.
    public func width(s: String, st: TextStyle, scale: Float): Float {
        val f = this.faceFor(st)
        if (f == null) { return 0.0 }
        val px = st.size * scale
        var w = 0.0
        for (ch in s.chars()) { w = w + advanceOf(f, ch.code(), px) }
        return w / scale
    }

    /// Baseline to baseline, in points.
    public func lineHeight(st: TextStyle, scale: Float): Float {
        val f = this.faceFor(st)
        if (f == null) { return st.size * 1.4 }
        return f.lineHeight(st.size * scale) / scale
    }

    /// How far the tallest letter reaches above the baseline, in points.
    public func ascent(st: TextStyle, scale: Float): Float {
        val f = this.faceFor(st)
        if (f == null) { return st.size * 0.8 }
        return f.ascent(st.size * scale) / scale
    }

    /// Draw a string with its baseline at `baseline`, starting at `x`.
    /// Answers where the pen ended up, in points.
    public func draw(c: Canvas, s: String, x: Float, baseline: Float, st: TextStyle, col: Int): Float {
        val f = this.faceFor(st)
        if (f == null) { return x }
        if (alphaOf(col) == 0) { return x }
        val scale = c.scale
        val px = st.size * scale
        var pen = x * scale
        val by = (baseline * scale).round()
        for (ch in s.chars()) {
            val g = f.glyphOf(ch.code(), px)
            if (g.mask != 0) { c.mask(g.mask, g.w, g.h, pen.round() + g.left, by - g.top, col) }
            pen = pen + g.advance
        }
        return pen / scale
    }

    /// Draw a single line inside a box: aligned across, centred down the
    /// middle, and cut with an ellipsis if it does not fit. This is what a
    /// label, a button and a menu item all call.
    public proc drawIn(c: Canvas, s: String, r: Rect, align: Int, st: TextStyle, col: Int) {
        val scale = c.scale
        val shown = this.ellipsize(s, r.w, st, scale)
        val w = this.width(shown, st, scale)
        var x = r.x
        if (align == 1) { x = r.x + (r.w - w) / 2.0 }
        if (align == 2) { x = r.x + r.w - w }
        val asc = this.ascent(st, scale)
        val lh = this.lineHeight(st, scale)
        // Centre the text's own box in the rectangle, not its baseline: a line
        // of capitals and a line of descenders then sit at the same height.
        val baseline = r.y + (r.h - lh) / 2.0 + asc
        this.draw(c, shown, x, baseline, st, col)
    }

    /// The longest prefix of `s` that fits in `maxW` points, with `…` in place
    /// of what was dropped. Answers `s` unchanged when it fits.
    public func ellipsize(s: String, maxW: Float, st: TextStyle, scale: Float): String {
        if (this.width(s, st, scale) <= maxW) { return s }
        val dots = "…"
        val dw = this.width(dots, st, scale)
        if (dw > maxW) { return "" }
        val cs = s.chars()
        var w = 0.0
        var n = 0
        while (n < cs.size) {
            val cw = this.width(cs[n], st, scale)
            if (w + cw + dw > maxW) { break }
            w = w + cw
            n++
        }
        if (n == 0) { return dots }
        return s.take(n) + dots
    }

    /// Break `s` into lines no wider than `maxW`, at spaces where it can and
    /// mid-word where it must. Existing newlines are kept.
    public func wrap(s: String, maxW: Float, st: TextStyle, scale: Float): List<String> {
        val out: List<String> = []
        for (para in s.split("\n")) {
            if (para == "") { out.add(""); continue }
            var line = ""
            for (word in para.split(" ")) {
                val trial = if (line == "") { word } else { line + " " + word }
                if (this.width(trial, st, scale) <= maxW) {
                    line = trial
                } else {
                    if (line != "") { out.add(line) }
                    // A single word too long for the column is cut by character
                    // rather than left to overflow.
                    var rest = word
                    while (this.width(rest, st, scale) > maxW) {
                        var n = 1
                        while (n < rest.length) {
                            if (this.width(rest.take(n + 1), st, scale) > maxW) { break }
                            n++
                        }
                        out.add(rest.take(n))
                        rest = rest.drop(n)
                    }
                    line = rest
                }
            }
            out.add(line)
        }
        return out
    }

    /// Draw wrapped text from the top of `r` down, answering the height it
    /// used, in points.
    public func drawWrapped(c: Canvas, s: String, r: Rect, st: TextStyle, col: Int): Float {
        val scale = c.scale
        val lines = this.wrap(s, r.w, st, scale)
        val lh = this.lineHeight(st, scale)
        val asc = this.ascent(st, scale)
        var i = 0
        while (i < lines.size) {
            val y = r.y + i.toFloat() * lh
            if (y > r.y + r.h) { break }
            this.draw(c, lines[i], r.x, y + asc, st, col)
            i++
        }
        return lines.size.toFloat() * lh
    }

    /// Break `s` into lines the way `wrap` does, but as **offsets** into the
    /// string rather than as copies of it.
    ///
    /// `wrap` above is for showing text and loses where each line came from —
    /// it rebuilds its lines with `line + " " + word`, so a run of two spaces
    /// comes back as one and no offset survives. That is enough to draw a
    /// paragraph and not enough to put a caret in it.
    ///
    /// **A break consumes its character**, the space exactly as the newline
    /// does. So the lines partition the string: every offset from 0 to its
    /// length belongs to exactly one line, and the question "which line is the
    /// caret on" has one answer. Editors that keep the space at the end of the
    /// visual line have two answers at every wrap — the end of one line and
    /// the start of the next are the same offset — and buy their way out with
    /// a caret *affinity*, a hidden bit saying which of the two was meant. One
    /// consumed space is cheaper than a bit that every operation has to carry
    /// correctly, and what it costs is a caret position nobody wants: the one
    /// after the space that ended a line.
    ///
    /// One exception, and it is unavoidable: a word too long for the column is
    /// cut mid-word, and there no character is consumed, so that one offset
    /// does sit on two lines. It is given to the earlier of them, which is
    /// what keeps End on the line above from landing on the line below.
    public func wrapLines(s: String, maxW: Float, st: TextStyle, scale: Float): List<Line> {
        val cs = s.chars()
        val n = cs.size
        val out: List<Line> = []
        var start = 0
        var i = 0
        var w = 0.0
        // The last space seen on the line being built, and -1 for none.
        var space = -1
        while (i < n) {
            val c = cs[i]
            if (c == "\n") {
                out.add(Line(start, i, true))
                i++
                start = i
                w = 0.0
                space = -1
                continue
            }
            val cw = this.width(c, st, scale)
            // A space is allowed to overflow rather than to break: a line
            // ending in a space that does not fit would otherwise wrap on
            // nothing visible. The next real character is what breaks.
            if ((c != " ") and ((w + cw > maxW) and (i > start))) {
                if (space >= 0) {
                    out.add(Line(start, space, false))
                    start = space + 1
                } else {
                    out.add(Line(start, i, false))
                    start = i
                }
                i = start
                w = 0.0
                space = -1
                continue
            }
            if (c == " ") { space = i }
            w = w + cw
            i++
        }
        // Always one more, so that an empty string is one empty line and a
        // string ending in a newline has a line after it for the caret.
        out.add(Line(start, n, false))
        return out
    }

    /// Which character boundary in `s` lies nearest `dx` points from its
    /// start — the caret position a click asks for.
    public func indexAt(s: String, dx: Float, st: TextStyle, scale: Float): Int {
        val cs = s.chars()
        var w = 0.0
        var i = 0
        while (i < cs.size) {
            val cw = this.width(cs[i], st, scale)
            if (dx < w + cw / 2.0) { return i }
            w = w + cw
            i++
        }
        return cs.size
    }

    /// How far into the string, in points, character `i` begins.
    public func xOfIndex(s: String, i: Int, st: TextStyle, scale: Float): Float {
        return this.width(s.take(i.max(0)), st, scale)
    }
}

/// The three system faces, loaded. Missing ones stay null and text in that
/// face falls back — an application still runs on a machine with no fonts,
/// which is the state a fresh container is in.
public func systemFonts(): Fonts {
    return Fonts(systemFont(0), systemFont(1), systemFont(2))
}
